local function isEggAllowedByPickupFilter(eggName, rarity)
    local hasRFilter = hasActiveFilter(CFG.PickupSelectedRarities)
    local hasEFilter = hasActiveFilter(CFG.PickupSelectedEggs)

    -- Jika tidak ada centang sama sekali, ambil semua telur (respecting fallback common)
    if not hasRFilter and not hasEFilter then
        if CFG.IgnoreCommonFallback and (eggName == "White Egg" or eggName == "Brown Egg") then
            return false
        end
        return true
    end

    -- Jika ada yang dicentang: cukup cocok dengan Rarity ATAU cocok dengan Egg Name ("both gitu")
    local rarityMatch = hasRFilter and isSelectedInMulti(CFG.PickupSelectedRarities, rarity)
    local eggMatch = hasEFilter and isSelectedInMulti(CFG.PickupSelectedEggs, eggName)

    return rarityMatch or eggMatch
end

local function findBestPickupEgg()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local rendered = workspace:FindFirstChild("RenderedEggs")
    if not rendered then return nil end

    local candidates = {}
    for _, eggModel in ipairs(rendered:GetChildren()) do
        local prompt = nil
        for _, d in ipairs(eggModel:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled then
                prompt = d
                break
            end
        end

        if prompt and prompt.Parent then
            local eggType = prompt.ObjectText or eggModel.Name
            local data = EGG_DATA[eggType] or {luck = 1, tier = "Common"}
            
            if isEggAllowedByPickupFilter(eggType, data.tier) then
                local dist = (prompt.Parent.Position - hrp.Position).Magnitude
                table.insert(candidates, {
                    model = eggModel,
                    prompt = prompt,
                    type = eggType,
                    luck = data.luck,
                    tier = data.tier,
                    dist = dist,
                    pos = prompt.Parent.Position
                })
            end
        end
    end

    -- Fallback jika kandidat kosong tapi filter tidak strict dan tidak ada centang
    local hasAnyFilter = hasActiveFilter(CFG.PickupSelectedRarities) or hasActiveFilter(CFG.PickupSelectedEggs)

    if #candidates == 0 and not hasAnyFilter and not CFG.StrictFilter then
        for _, eggModel in ipairs(rendered:GetChildren()) do
            local prompt = nil
            for _, d in ipairs(eggModel:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled then
                    prompt = d
                    break
                end
            end
            if prompt and prompt.Parent then
                local eggType = prompt.ObjectText or eggModel.Name
                local data = EGG_DATA[eggType] or {luck = 1, tier = "Common"}
                local dist = (prompt.Parent.Position - hrp.Position).Magnitude
                table.insert(candidates, {
                    model = eggModel,
                    prompt = prompt,
                    type = eggType,
                    luck = data.luck,
                    tier = data.tier,
                    dist = dist,
                    pos = prompt.Parent.Position
                })
            end
        end
    end

    if #candidates == 0 then return nil end

    if CFG.PickupSortMode == "Rarest" then
        table.sort(candidates, function(a, b)
            if a.luck == b.luck then return a.dist < b.dist end
            return a.luck > b.luck
        end)
    else
        table.sort(candidates, function(a, b) return a.dist < b.dist end)
    end

    return candidates[1]
end

local function stopAutoPickup()
