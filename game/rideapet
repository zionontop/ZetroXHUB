local function tweenTo(targetPos, speed, checkCondition)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    speed = speed or CFG.TweenSpeed or 220
    local dist = (targetPos - hrp.Position).Magnitude
    local duration = math.max(0.12, dist / speed)

    setNoclip(true)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    if currentTween then
        pcall(function() currentTween:Cancel() end)
    end
    currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})

    local completed = false
    local conn = currentTween.Completed:Connect(function()
        completed = true
    end)

    currentTween:Play()

    local elapsed = 0
    while not completed do
        task.wait(0.04)
        elapsed = elapsed + 0.04
        if checkCondition and not checkCondition() then
            if currentTween then pcall(function() currentTween:Cancel() end) end
            break
        end
        if elapsed > duration + 2 then break end
    end

    if conn then conn:Disconnect() end
    currentTween = nil

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    setNoclip(false)
    return completed or ((targetPos - hrp.Position).Magnitude < 10)
end

