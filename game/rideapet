local function plantEggTool(tool)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local plot = getMyPlot()
    if not (char and hum and plot and tool and tool.Parent) then return false end

    local eggName = tool.Name
