-- Helper Multi-Dropdown Selector (Mendukung format array {"Value"} dan map {["Value"] = true})
local function isSelectedInMulti(filterTable, value)
    if not filterTable or type(filterTable) ~= "table" then return false end
    if not value then return false end
    local valStr = tostring(value):lower()
    for k, v in pairs(filterTable) do
        if v == true and tostring(k):lower() == valStr then
            return true
        elseif tostring(v):lower() == valStr then
            return true
        end
    end
    return false
end

local function hasActiveFilter(filterTable)
    if not filterTable or type(filterTable) ~= "table" then return false end
    for k, v in pairs(filterTable) do
        if v == true or (type(v) == "string" and v ~= "") then return true end
    end
    return false
end

