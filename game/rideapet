local function cleanPetName(rawName)
    if not rawName then return "" end
    local cleaned = rawName:gsub("%s*%[[^%]]*%]", "")
    return cleaned:match("^%s*(.-)%s*$") or cleaned
end

-- Helper Info Pet di Tas / Karakter
local function getToolPetInfo(tool)
    local attrName = tool:GetAttribute("PetName")
    local pName = cleanPetName(attrName or tool.Name)
    local pKey = tool:GetAttribute("PetKey")
    local pData = PetsDataModule and (PetsDataModule[pName] or PetsDataModule[cleanPetName(tool.Name)])
    local pRarity = tool:GetAttribute("Rarity") or (pData and (pData.Rarity or pData.Tier)) or "Common"
    local pIncome = tonumber(tool:GetAttribute("Income")) or (pData and tonumber(pData.Income)) or 0
    local isFav = tool:GetAttribute("Favorited") == true or tool:GetAttribute("Favorite") == true
    return {
        tool = tool,
        name = pName,
        rawName = tool.Name,
        key = pKey,
        rarity = pRarity,
        income = pIncome,
        favorited = isFav,
    }
end

-- Filter Cek Apakah Pet Boleh Dijual (Strict Blacklist & Favorite Protection)
local function shouldSellPet(info)
    if not info or not info.tool or not info.tool.Parent then return false end
    -- 1. Perlindungan Favorit
    if info.favorited then return false end
    -- 2. Perlindungan Pet yang sedang dinaiki (Riding)
    if LocalPlayer:GetAttribute("IsRiding") == true and info.tool.Parent == LocalPlayer.Character then
        return false
    end
    -- 3. Perlindungan Blacklist (Dilarang Dijual)
    if isSelectedInMulti(CFG.SellBlacklistPets, info.name) or isSelectedInMulti(CFG.SellBlacklistPets, info.rawName) then return false end
    if isSelectedInMulti(CFG.SellBlacklistPets, info.rarity) then return false end

    local hasRarityFilter = hasActiveFilter(CFG.SellSelectedRarities)
    local hasNameFilter   = hasActiveFilter(CFG.SellSelectedPets)
    local hasIncomeFilter = (CFG.SellIncomeThreshold and CFG.SellIncomeThreshold > 0)

    -- Jika tidak ada satupun filter jual yang aktif, JANGAN jual apa-apa (Safe Default)
    if not hasRarityFilter and not hasNameFilter and not hasIncomeFilter then
        return false
    end

    local matchRarity = hasRarityFilter and isSelectedInMulti(CFG.SellSelectedRarities, info.rarity)
    local matchName   = hasNameFilter and (isSelectedInMulti(CFG.SellSelectedPets, info.name) or isSelectedInMulti(CFG.SellSelectedPets, info.rawName))
    local matchIncome = hasIncomeFilter and (info.income < CFG.SellIncomeThreshold)

    return matchRarity or matchName or matchIncome
end

