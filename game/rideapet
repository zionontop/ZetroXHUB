local function setLanguage(lang)
    CFG.Language = lang
    local isEN = (lang == "EN")
    
    -- 1. Update Element Teks & Groupboxes
    for _, item in ipairs(UI_ELEMENTS) do
        if item.isGroupbox then
            pcall(function()
                local gb = item.element
                local targetText = isEN and item.en or item.id
                if gb and gb.Container and gb.Container.Parent then
                    for _, desc in ipairs(gb.Container.Parent:GetDescendants()) do
                        if desc:IsA("TextLabel") and (desc.Text == item.id or desc.Text == item.en) then
                            desc.Text = targetText
                            break
                        end
                    end
                end
            end)
        elseif item.element and item.element.SetText then
            pcall(function()
                item.element:SetText(isEN and item.en or item.id)
            end)
        end
    end

    -- 2. Update Sidebar Tab Labels
    pcall(function()
        local tabTranslations = {
            ["Auto Pickup"] = { id = "Auto Pickup", en = "Auto Pickup" },
            ["Hatching & Place"] = { id = "Tetas & Tanam", en = "Hatch & Place" },
            ["Hatch & Place"] = { id = "Tetas & Tanam", en = "Hatch & Place" },
            ["Rebirth & Luck"] = { id = "Rebirth & Keberuntungan", en = "Rebirth & Luck" },
            ["Shop & Feed"] = { id = "Toko & Pakan", en = "Shop & Feed" },
            ["Player"] = { id = "Pemain", en = "Player" },
            ["Community"] = { id = "Komunitas", en = "Community" },
            ["Settings"] = { id = "Pengaturan", en = "Settings" },
            ["Info"] = { id = "Informasi", en = "Info" },
        }
        if Window and Window.MainFrame then
            for _, desc in ipairs(Window.MainFrame:GetDescendants()) do
                if desc:IsA("TextLabel") then
                    for orig, tr in pairs(tabTranslations) do
                        if desc.Text == tr.id or desc.Text == tr.en or desc.Text == orig then
                            desc.Text = isEN and tr.en or tr.id
                            break
                        end
                    end
                end
            end
        end
    end)
end

