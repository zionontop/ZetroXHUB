            end
        end
        return bestPet and {bestPet} or {}
    elseif CFG.FeedFilterMode == "By Income" then
        local targets = {}
        for _, p in ipairs(allPets) do
            local inc = getPetIncome(p)
            if inc >= (CFG.FeedTargetIncome or 0) then
                table.insert(targets, p)
            end
        end
        return targets
    elseif CFG.FeedFilterMode == "By Age" then
        local targets = {}
        for _, p in ipairs(allPets) do
            local age = tonumber(p:GetAttribute("Age")) or 0
            if CFG.FeedAgeCondition == "Below" then
                if age < (CFG.FeedTargetAge or 100) then
                    table.insert(targets, p)
                end
            else
                if age > (CFG.FeedTargetAge or 0) then
                    table.insert(targets, p)
                end
            end
        end
        return targets
    end
    return allPets
end

