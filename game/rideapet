        return true
    end
    return false
end

-- Helper Parser Input Angka dengan Suffix (e.g. 100m, 50k, 1.5b, 10t)
local function parseSuffixNumber(str)
    if not str or str == "" then return 0 end
    str = tostring(str):lower():gsub("%s+", ""):gsub("%$", ""):gsub("/s", ""):gsub(",", "")
    local num, suffix = str:match("^([%d%.]+)([a-z]*)$")
    num = tonumber(num)
    if not num then return 0 end
    if suffix == "k" then return num * 1e3
    elseif suffix == "m" then return num * 1e6
    elseif suffix == "b" then return num * 1e9
    elseif suffix == "t" then return num * 1e12
    elseif suffix == "q" or suffix == "qa" then return num * 1e15
    end
    return num
end

