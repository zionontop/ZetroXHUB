    pickupLoopRunning = true
    CFG.AutoPickup = true

    task.spawn(function()
        while pickupLoopRunning do
            -- 1. Cek apakah basket sudah penuh (1/1)
            if isBasketFull() then
                returnViaVoid()
                if not pickupLoopRunning then break end
                depositCarriedEgg()
            end

            if not pickupLoopRunning then break end

            -- 2. Cari target telur terbaik
            local target = findBestPickupEgg()
