-- Rutinitas Menanam Telur Otomatis
local function executePlaceEggsRoutine()
    -- 1. Cek keranjang (Basket)
    if isBasketFull() then
        depositCarriedEgg()
        task.wait(0.3)
    end

    -- 2. Kumpulkan telur yang valid dari Backpack & Character
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    local char = LocalPlayer.Character
    local eggTools = {}

    local function checkTool(t)
        if t:IsA("Tool") and (t:HasTag("Egg") or t.Name:find("Egg") or t:GetAttribute("EggKey")) then
            local eggData = EGG_DATA[t.Name] or {luck = 1, tier = "Common"}
            if isEggAllowedByPlaceFilter(t.Name, eggData.tier) then
                table.insert(eggTools, {
                    tool = t,
                    name = t.Name,
                    luck = eggData.luck or 0,
                    tier = eggData.tier,
                })
            end
        end
    end

    if bp then
        for _, t in ipairs(bp:GetChildren()) do checkTool(t) end
    end
    if char then
        for _, t in ipairs(char:GetChildren()) do checkTool(t) end
    end

    if #eggTools == 0 then return end

    -- Urutkan prioritas: Jika AutoPlaceBestEggs aktif, tanam yang paling langka (highest luck) lebih dulu!
    if CFG.AutoPlaceBestEggs then
        table.sort(eggTools, function(a, b)
            return a.luck > b.luck
        end)
    end

    for _, entry in ipairs(eggTools) do
        if not CFG.AutoPlaceEgg then break end
        if entry.tool and entry.tool.Parent then
            plantEggTool(entry.tool)
            task.wait(0.4)
        end
    end
end

