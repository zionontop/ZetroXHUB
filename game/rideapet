local function sellPetTool(tool)
    if not (tool and tool.Parent) then return false end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (char and hum) then return false end

    local stalls = workspace:FindFirstChild("Stalls", true)
    local richie = (stalls and stalls:FindFirstChild("Sell") and stalls.Sell:FindFirstChild("Richie")) or workspace:FindFirstChild("Richie", true)
    if not richie then return false end

    local prompt = richie:FindFirstChild("HumanoidRootPart") and richie.HumanoidRootPart:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then return false end

    local DialogueRemotes = ReplicatedStorage:FindFirstChild("Dialogue") and ReplicatedStorage.Dialogue:FindFirstChild("Remotes")
    local DialogueSelect = DialogueRemotes and DialogueRemotes:FindFirstChild("DialogueSelect")
    local DialogueSend = DialogueRemotes and DialogueRemotes:FindFirstChild("DialogueSend")
    if not (DialogueSelect and DialogueSend) then return false end

    -- 1. Equip tool ke karakter DULU (server perlu lihat tool di tangan sebelum dialogue)
    hum:EquipTool(tool)
    local eqWait = 0
    while tool.Parent ~= char and eqWait < 1.0 do
        task.wait(0.05)
        eqWait = eqWait + 0.05
    end
    if tool.Parent ~= char then return false end
    task.wait(0.1)

    -- 2. Reset InDialogue attribute agar prompt bisa di-fire ulang
    pcall(function() prompt:SetAttribute("InDialogue", false) end)

    -- 3. Fire prompt dan tunggu event DialogueSend dari server (JANGAN destroy dialogue dulu!)
    local dialogueReceived = false
    local conn = DialogueSend.OnClientEvent:Connect(function()
        dialogueReceived = true
    end)
    pcall(function() fireproximityprompt(prompt) end)

    local waitDial = 0
    while not dialogueReceived and waitDial < 1.5 do
        task.wait(0.05)
        waitDial = waitDial + 0.05
    end
    conn:Disconnect()

    if not dialogueReceived then
        pcall(function() hum:UnequipTools() end)
        return false
    end

    task.wait(0.05)

    -- 4. Sekarang baru fire DialogueSelect (pet sudah di tangan + dialogue sudah aktif)
    pcall(function()
        DialogueSelect:FireServer(richie, "I would like to sell this")
    end)

    -- 5. Tunggu server konfirmasi penjualan (tool lenyap dari character)
    local maxWait = CFG.SellWaitPerPet or 3.0
    local elapsed = 0
    local isSold = false
    while elapsed < maxWait do
        if not tool or not tool.Parent or not tool:IsDescendantOf(game) then
            isSold = true
            break
        end
        task.wait(0.08)
        elapsed = elapsed + 0.08
    end

    -- 6. Setelah selesai (berhasil atau tidak), BARU bersihkan sisa UI dialogue
    cleanRichieDialogueUI(richie)

    if isSold then
        stats.petsSold = (stats.petsSold or 0) + 1
        task.wait(CFG.SellItemDelay or 0.2)
        return true
    else
        pcall(function() hum:UnequipTools() end)
        task.wait(0.2)
        return false
    end
end


