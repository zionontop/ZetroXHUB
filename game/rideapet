local function isEggAllowedByPlaceFilter(eggName, rarity)
    local hasRFilter = hasActiveFilter(CFG.PlaceSelectedRarities)
    local hasEFilter = hasActiveFilter(CFG.PlaceSelectedEggs)

    -- Jika tidak ada satupun yang dicentang, semua telur boleh ditaruh/ditanam
    if not hasRFilter and not hasEFilter then
        return true
    end

    -- Jika ada yang dicentang: cocok dengan Rarity ATAU cocok dengan Egg Name ("both gitu")
    local rMatch = hasRFilter and isSelectedInMulti(CFG.PlaceSelectedRarities, rarity)
    local eMatch = hasEFilter and isSelectedInMulti(CFG.PlaceSelectedEggs, eggName)
    return rMatch or eMatch
end

