-- Helper resmi untuk mendapatkan Tier (1-25) & Nama Resmi Dadu (Bilingual ID/EN Support)
local function getTierForDice(name)
    if not name or typeof(name) ~= "string" then return nil, nil end
    local raw = name:lower()
    if #raw > 45 then return nil, nil end
    if raw:find("defeat") or raw:find("attack") or raw:find("quest") or raw:find("kill") or raw:find("boss") then
        return nil, nil
    end

    local clean = raw:gsub("dice%s*:%s*", ""):gsub("%s*dice%s*", " ")
    clean = clean:gsub("dadu%s*:%s*", ""):gsub("%s*dadu%s*", " ")
    clean = clean:gsub("%[tier%s*%d+%]", ""):gsub("%(tier%s*%d+%)", ""):gsub("tier%s*%d+", "")
    if clean:find("|") then clean = clean:split("|")[1] end
    if clean:find(":") then clean = clean:split(":")[1] end
    if clean:find("-") then clean = clean:split("-")[1] end
    clean = clean:gsub("^%s+", ""):gsub("%s+$", "")
    if clean == "" then return nil, nil end

    -- 1. Direct dictionary lookup (Sangat cepat & 100% Akurat untuk ID/EN)
    local entry = DICE_NAME_TO_TIER[clean]
    if entry then
        return entry.tier, entry.name
    end

    -- 2. Exact match with FALLBACK_25_DICES
    for idx, dName in ipairs(FALLBACK_25_DICES) do
        if clean == dName:lower() then
            return idx, dName
        end
    end

    -- 3. Standalone word match dari kamus
    for word, data in pairs(DICE_NAME_TO_TIER) do
        if clean:find("^" .. word .. "$") or clean:find("^" .. word .. "%s") or clean:find("%s" .. word .. "$") or clean:find("%s" .. word .. "%s") then
            return data.tier, data.name
        end
    end

    return nil, nil
end

-- Helper Parser Singkatan Angka (Support: 1k, 100k, 1m, 100m, 1b, 10b, 1t, 1qd, dll)
local SUFFIX_MULTIPLIERS = {
    k   = 1e3,
    m   = 1e6,
    b   = 1e9,
    t   = 1e12,
    qa  = 1e15,
    qd  = 1e15,
    qi  = 1e18,
    qn  = 1e18,
    sx  = 1e21,
    sp  = 1e24,
    oc  = 1e27,
    no  = 1e30,
    n   = 1e30,
    dc  = 1e33,
    ud  = 1e36,
    dd  = 1e39,
    td  = 1e42,
}

local function parseFormattedNumber(val)
    if not val then return nil end
    if typeof(val) == "number" then return val end
    if typeof(val) ~= "string" then return nil end
    
    local s = val:lower():gsub("%s+", ""):gsub(",", ""):gsub("%$", "")
    if s == "" then return nil end
    
    local num = tonumber(s)
    if num then return num end
    
    local numPart, suffixPart = s:match("^([%d%.]+)%s*([a-z]+)$")
    if numPart and suffixPart then
        local baseNum = tonumber(numPart)
        local mult = SUFFIX_MULTIPLIERS[suffixPart]
        if baseNum and mult then
            return math.floor(baseNum * mult)
        end
    end
    
    return nil
end

-- Formula Threshold Rarity Skala Per N Tier Update Dadu (Default: Tiap 4 Tier, Dapat Diatur)
local function calculateThresholdForTier(tier)
    -- 1. Khusus Tier di atas 16 (Tier 17 - 25): BISA DIATUR MANUAL BEBAS DI CONFIG (SUPPORT 100M, 1B, 1T, DLL)!
    if tier > 16 then
        if Config.CustomTierThresholds and typeof(Config.CustomTierThresholds) == "table" then
            local rawVal = Config.CustomTierThresholds[tier] or Config.CustomTierThresholds[tostring(tier)]
            if rawVal then
                local pVal = parseFormattedNumber(rawVal)
                if pVal then return pVal end
            end
        end
        if Config.CustomThresholdAboveTier16 then
            local pVal = parseFormattedNumber(Config.CustomThresholdAboveTier16)
            if pVal then return pVal end
        end
    end

    -- 2. Tier 1 s/d 16: Hitungan Otomatis SAMA persis seperti sebelumnya
    local stepInterval = math.max(1, Config.SellThresholdTierStep or 4)
    if tier <= 1 then
        return 0 -- Tier 1 (Normal): Gada sell threshold sampai upgrade ke Tier 2!
    elseif tier < stepInterval then
        return parseFormattedNumber(Config.DefaultSellThreshold) or parseFormattedNumber(Config.SellThresholdBase) or 1000
    elseif tier >= 25 then
        return 10000000000000 -- 10T (Max Tier)
    end
    local stepCount = math.floor((tier - stepInterval) / stepInterval)
    local startVal = parseFormattedNumber(Config.SellThresholdStartValue) or 100000
    local mult = Config.SellThresholdMultiplier or 10
    return math.floor(startVal * (mult ^ stepCount))
end

