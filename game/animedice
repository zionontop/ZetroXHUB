        local rawOwned = pState.OwnedDice or pState.OwnedDices or pState.Dices or pState.Dice
        if typeof(rawOwned) == "table" then
            for k, v in pairs(rawOwned) do
                local kStr = tostring(k):lower()
                local vStr = tostring(v):lower()

                -- 1. Periksa apakah key adalah nama dadu resmi (cth: ["Water"] = "true" atau ["Water"] = true)
                local tK, nK = getTierForDice(tostring(k))
                if tK then
                    if v == true or vStr == "true" or v == 1 or vStr == "1" or typeof(v) == "table" then
                        owned[nK:lower()] = true
                    end
                end

                -- 2. Periksa jika format tabel adalah array string: {[1] = "Water", [2] = "Fire"}
                local tV, nV = getTierForDice(tostring(v))
                if tV then
                    owned[nV:lower()] = true
                end
            end
        end
        local curDice = pState.Dice or pState.EquippedDice
        if curDice and typeof(curDice) == "string" and curDice ~= "" then
            local tC, nC = getTierForDice(curDice)
            if nC then owned[nC:lower()] = true else owned[curDice:lower()] = true end
        end
    end

    local cards = scanRealDiceShopCards()
    for _, c in ipairs(cards) do
        if (c.IsOwned or c.IsEquipped) and c.Name then
            local tC, nC = getTierForDice(c.Name)
            if nC then owned[nC:lower()] = true else owned[c.Name:lower()] = true end
        end
    end

    if detectedEquippedName and detectedEquippedName ~= "" then
        local tD, nD = getTierForDice(detectedEquippedName)
        if nD then owned[nD:lower()] = true else owned[detectedEquippedName:lower()] = true end
    end

    if confirmedHighestOwnedTier and confirmedHighestOwnedTier > 1 then
        for i = 1, confirmedHighestOwnedTier do
            local fn = FALLBACK_25_DICES[i]
            if fn then owned[fn:lower()] = true end
        end
    end

    return owned
end

-- Fungsi Khusus: Memasang Dadu Tertinggi yang Sudah Dimiliki Akun (100% Akurat)
local function autoEquipBestDice()
    local equipRem = getEquipDiceRemote()
    local owned = getOwnedDiceMap()
    local cards = scanRealDiceShopCards()

    local highestOwnedTier = 1
    local highestOwnedName = "Normal"

    for _, d in ipairs(DICE_ORDERED) do
        local dLower = d.name:lower()
        if owned[dLower] then
            if d.tier > highestOwnedTier then
                highestOwnedTier = d.tier
                highestOwnedName = d.name
            end
        end
    end

    confirmedHighestOwnedTier = math.max(confirmedHighestOwnedTier or 1, highestOwnedTier)

    local pState = getPlayerDataState()
    local actualEquipped = (pState and (pState.Dice or pState.EquippedDice)) or detectedEquippedName or ""

    if actualEquipped:lower() ~= highestOwnedName:lower() then
        if equipRem then
            pcall(function() equipRem:FireServer(highestOwnedName) end)
            pcall(function() equipRem:FireServer(highestOwnedName .. " Dice") end)
            if highestOwnedTier == 4 then pcall(function() equipRem:FireServer("Earth") end) end
        end

        for _, card in ipairs(cards) do
            if card.Tier == highestOwnedTier and card.Button and not card.IsEquipped then
                activateButton(card.Button)
                break
            end
        end

        detectedEquippedTier = highestOwnedTier
        detectedEquippedName = highestOwnedName
        Config.CurrentDiceTier = highestOwnedTier
        Config.CurrentDiceName = highestOwnedName

        local newThresh = calculateThresholdForTier(highestOwnedTier)
        updateThresholdForDice(highestOwnedName, highestOwnedTier, newThresh)
        pcall(updateDiceStatusLabel)
    end

    return highestOwnedName, highestOwnedTier
end

-- Fungsi Pembeli Dadu Progresif (Membeli Tier Berikutnya Secara Urut & Langsung Memasang)
local function smartProgressiveBuyDice()
    autoCloseRobuxShop()

    -- Pasang dulu dadu terbaik yang ada di tas
    autoEquipBestDice()

    local buyRem = getBuyDiceRemote()
    local equipRem = getEquipDiceRemote()
    local curMoney = getPlayerMoney()
    local owned = getOwnedDiceMap()
    local cards = scanRealDiceShopCards()

    -- Cari tier-tier yang belum dimiliki jika saldo cukup
    local toBuy = {}
    for _, d in ipairs(DICE_ORDERED) do
        local dLower = d.name:lower()
        if not owned[dLower] then
            if curMoney >= d.price then
                table.insert(toBuy, d)
                curMoney = curMoney - d.price
                owned[dLower] = true
            else
                -- Saldo tidak cukup untuk tier ini, stop pass (Zero Remote Spam)
                break
            end
        end
    end

    if #toBuy == 0 then return end

    -- Server Roblox Anime Dice mewajibkan karakter berada di dalam zona Workspace.Zones.DiceShop untuk membeli dadu
    local p = game:GetService("Players").LocalPlayer
    local char = p.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local zone = workspace:FindFirstChild("Zones") and workspace.Zones:FindFirstChild("DiceShop")

    local oldCFrame = nil
    if hrp and zone and (hrp.Position - zone.Position).Magnitude > 25 then
        oldCFrame = hrp.CFrame
        hrp.CFrame = zone.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.25)
    end

    for _, d in ipairs(toBuy) do
        if buyRem then
            pcall(function() buyRem:FireServer(d.name) end)
            pcall(function() buyRem:FireServer(d.name .. " Dice") end)
            if d.tier == 4 then pcall(function() buyRem:FireServer("Earth") end) end
        end

        for _, card in ipairs(cards) do
            if card.Tier == d.tier and card.Button and not card.IsOwned then
                activateButton(card.Button)
                break
            end
        end

        task.wait(0.2)
    end

    -- Kembalikan posisi karakter ke titik semula
    if oldCFrame and hrp and hrp.Parent then
        hrp.CFrame = oldCFrame
    end

    -- Langsung pasang dadu tertinggi yang baru dibeli
    autoEquipBestDice()
end

