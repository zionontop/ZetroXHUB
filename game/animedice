local isSellingBagUnits = false
local function autoSellBagUnitsBelowThreshold()
    if isSellingBagUnits then return end
    local sellRem = Remotes.SellEquipped
    local equipRem = Remotes.UnitEquip
    if not sellRem or not equipRem then return end

    local currentThreshold = tonumber(Config.SellThreshold) or 0
    if currentThreshold <= 0 then return end

    local pState = getPlayerDataState()
    if not pState or not pState.Inventory then return end

    isSellingBagUnits = true
    pcall(function()
        local protectedUnitIds = {}
        if pState.Slots then
            for _, sData in pairs(pState.Slots) do
                if typeof(sData) == "table" and sData.unitId then
                    protectedUnitIds[tostring(sData.unitId)] = true
                end
            end
        end

        if pState.TowerTeam then
            for _, tUnit in pairs(pState.TowerTeam) do
                if typeof(tUnit) == "string" then protectedUnitIds[tUnit] = true
                elseif typeof(tUnit) == "table" then
                    local tid = tUnit.unitId or tUnit.id or tUnit.UUID
                    if tid then protectedUnitIds[tostring(tid)] = true end
                end
            end
        end

        local unitsToSell = {}
        for itemId, item in pairs(pState.Inventory) do
            local idStr = tostring(itemId)
            if typeof(item) == "table" and item.attributes and item.name then
                if not protectedUnitIds[idStr] then
                    local isLocked = item.locked or item.favorite
                    if item.attributes and (item.attributes.locked or item.attributes.favorite) then
                        isLocked = true
                    end

                    if not isLocked then
                        local unitChance = getUnitChance(item)
                        if unitChance and unitChance > 0 and unitChance < currentThreshold then
                            table.insert(unitsToSell, {
                                id = idStr,
                                name = item.name,
                                chance = unitChance
                            })
                        end
                    end
                end
            end
        end

        if #unitsToSell > 0 then
            for i, unit in ipairs(unitsToSell) do
                pcall(function() equipRem:InvokeServer(unit.id) end)
                task.wait(0.12)
                pcall(function() sellRem:InvokeServer() end)
                task.wait(0.12)
            end

            task.wait(0.3)
            pcall(autoEquipBestRarityUnits)
        end
    end)
    isSellingBagUnits = false
end

