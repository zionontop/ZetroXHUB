-- 13. SPECIAL TRADE INJECTOR (CUSTOM QUANTITY BUTTON FOR TRADE MENU)
--------------------------------------------------------------------------------
do
    local function getOfferItemName(btn1k, container)
        local detectedName = nil

        -- Method 1: Check upvalues from button Activated connections
        local clickBtn = (btn1k:IsA("GuiButton") and btn1k) or btn1k:FindFirstChildWhichIsA("GuiButton", true)
        if clickBtn and getconnections and getupvalues then
            pcall(function()
                for _, conn in ipairs(getconnections(clickBtn.Activated)) do
                    if conn.Function then
                        local uvs = getupvalues(conn.Function)
                        for _, uv in pairs(uvs) do
                            if typeof(uv) == "string" and uv ~= "" and uv ~= "Offer 1k" and uv ~= "Offer" and not uv:find("Offer") then
                                detectedName = uv
                                break
                            elseif typeof(uv) == "table" then
                                for k, v in pairs(uv) do
                                    if typeof(v) == "string" and (k == "Name" or k == "Item" or k == "ItemName" or k == "Id") then
                                        detectedName = v
                                        break
                                    end
                                end
                            end
                        end
                    end
                    if detectedName then break end
                end
            end)
        end
        if detectedName then return detectedName end

        -- Method 2: Check container and ancestors for item attributes or title labels
        pcall(function()
            local cur = container
            for _ = 1, 5 do
                if not cur then break end
                local attr = cur:GetAttribute("ItemName") or cur:GetAttribute("Item") or cur:GetAttribute("Name")
                if attr and typeof(attr) == "string" and attr ~= "" then
                    detectedName = attr
                    return
                end
                for _, desc in ipairs(cur:GetChildren()) do
                    if (desc:IsA("TextLabel") or desc:IsA("TextBox")) and desc.Visible then
                        local t = desc.Text
                        if t and #t > 0 and not t:lower():find("offer") and not t:lower():find("trade") and not t:match("^%d+$") then
                            detectedName = t
                            return
                        end
                    end
                end
                cur = cur.Parent
            end
        end)
        return detectedName
    end

    local function injectSpecialTrade(container, directChild)
        if not container or container:FindFirstChild("OfferCustom") then return end

        pcall(function()
            local clone = directChild:Clone()
            clone.Name = "OfferCustom"
            if directChild.LayoutOrder then
                clone.LayoutOrder = directChild.LayoutOrder + 1
            end
            clone.Visible = true

            local targetLabel = nil
            if clone:IsA("TextButton") then
                targetLabel = clone
                clone.Text = "Offer Custom"
            end
            for _, ch in ipairs(clone:GetDescendants()) do
                if ch:IsA("TextLabel") then
                    ch.Text = "Offer Custom"
                    targetLabel = ch
                end
            end

            -- Ensure parent container does not clip the new button & expand height ONCE
            if container:IsA("GuiObject") then
                container.ClipsDescendants = false
                if container.Parent and container.Parent:IsA("GuiObject") then
                    container.Parent.ClipsDescendants = false
                end
                if container.AutomaticSize == Enum.AutomaticSize.None then
                    if not container:GetAttribute("OriginalHeight") then
                        container:SetAttribute("OriginalHeight", container.Size.Y.Offset)
                        local childH = (directChild.AbsoluteSize.Y > 0 and directChild.AbsoluteSize.Y) or 57
                        container.Size = UDim2.new(container.Size.X.Scale, container.Size.X.Offset, container.Size.Y.Scale, container.Size.Y.Offset + childH + 10)
                    end
                end
            end

            clone.Parent = container

            -- Setup click listener
            local clickTarget = (clone:IsA("GuiButton") and clone) or clone:FindFirstChildWhichIsA("GuiButton", true) or clone
            local isInputActive = false

            local function startCustomInput()
                if isInputActive or not targetLabel then return end
                isInputActive = true

                local input = Instance.new("TextBox")
                input.Name = "CustomAmountInput"
                input.Size = UDim2.new(0.92, 0, 0.85, 0)
                input.Position = UDim2.new(0.5, 0, 0.5, 0)
                input.AnchorPoint = Vector2.new(0.5, 0.5)
                input.BackgroundTransparency = 1
                input.Font = targetLabel.Font
                input.TextSize = targetLabel.TextSize
                input.TextScaled = true
                input.TextWrapped = true
                input.TextXAlignment = Enum.TextXAlignment.Center
                input.TextYAlignment = Enum.TextYAlignment.Center
                input.TextColor3 = Color3.fromRGB(255, 255, 255)
                input.PlaceholderColor3 = Color3.fromRGB(200, 245, 200)
                input.PlaceholderText = "Input Quantity"
                input.Text = ""
                input.ClearTextOnFocus = true
                input.ZIndex = (targetLabel.ZIndex or 1) + 20

                local origStroke = targetLabel:FindFirstChildWhichIsA("UIStroke")
                if origStroke then
                    local strokeClone = origStroke:Clone()
                    strokeClone.Parent = input
                else
                    input.TextStrokeTransparency = targetLabel.TextStrokeTransparency or 0
                    input.TextStrokeColor3 = targetLabel.TextStrokeColor3 or Color3.fromRGB(0, 0, 0)
                end

                input.Parent = targetLabel.Parent
                targetLabel.Visible = false

                task.wait(0.02)
                input:CaptureFocus()

                input.FocusLost:Connect(function(enterPressed)
                    local entered = tonumber(input.Text)
                    if enterPressed and entered and entered > 0 then
                        local amount = math.floor(entered)
                        local itemName = getOfferItemName(directChild, container)

                        local rem = Remotes.ChangeOffer
                        if not rem then
                            local rep = game:GetService("ReplicatedStorage")
                            local net = rep:FindFirstChild("Network")
                            local ts = net and net:FindFirstChild("TradeService")
                            rem = ts and ts:FindFirstChild("RE") and ts.RE:FindFirstChild("ChangeOffer")
                            if rem then Remotes.ChangeOffer = rem end
                        end

                        if rem and itemName then
                            pcall(function() rem:FireServer(itemName, amount) end)
                            Library:Notify({
                                Title = "Special Trade",
                                Description = "Offered " .. tostring(amount) .. "x " .. tostring(itemName) .. "!",
                                Time = 3
                            })
                        elseif rem then
                            pcall(function() rem:FireServer(amount) end)
                            Library:Notify({
                                Title = "Special Trade",
                                Description = "Offered " .. tostring(amount) .. "!",
                                Time = 3
                            })
                        else
                            Library:Notify({
                                Title = "Special Trade",
                                Description = "ChangeOffer remote not found!",
                                Time = 3
                            })
                        end
                    end

                    input:Destroy()
                    targetLabel.Visible = true
                    targetLabel.Text = "Offer Custom"
                    isInputActive = false
                end)
            end

            if clickTarget:IsA("GuiButton") then
                clickTarget.Activated:Connect(startCustomInput)
            else
                clickTarget.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        startCustomInput()
                    end
                end)
            end
        end)
    end

    local isScanning = false
    local function scanAndInject()
        if not Config.SpecialTrade or isScanning then return end
        local pGui = player:FindFirstChild("PlayerGui")
        if not pGui then return end

        -- Early exit: jika OfferCustom sudah ada di layar, jangan buang CPU!
        if pGui:FindFirstChild("OfferCustom", true) then return end

        isScanning = true
        pcall(function()
            for _, desc in ipairs(pGui:GetDescendants()) do
                if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Visible then
                    local t = desc.Text
                    if t and t ~= "" then
                        local clean = t:gsub("%s+", ""):lower()
                        if clean == "offer1k" or clean:find("offer1k") or clean == "offer1000" or clean:find("offer1000") then
                            local cur = desc.Parent
                            while cur and cur ~= pGui do
                                local hasSiblingOffer = false
                                for _, sibling in ipairs(cur:GetDescendants()) do
                                    if (sibling:IsA("TextLabel") or sibling:IsA("TextButton")) and sibling ~= desc then
                                        local sClean = sibling.Text:gsub("%s+", ""):lower()
                                        if sClean == "offer1" or sClean:find("offer10") or sClean:find("offer100") then
                                            hasSiblingOffer = true
                                            break
                                        end
                                    end
                                end

                                if hasSiblingOffer then
                                    local runner = desc
                                    while runner and runner.Parent ~= cur do
                                        runner = runner.Parent
                                    end
                                    if runner and not cur:FindFirstChild("OfferCustom") then
                                        injectSpecialTrade(cur, runner)
                                    end
                                    return
                                end
                                cur = cur.Parent
                            end
                        end
                    end
                end
            end
        end)
        isScanning = false
    end

    -- Fast 0.25s watcher loop (Zero Lag: tidak pakai DescendantAdded yang membombardir event)
    task.spawn(function()
        while task.wait(0.25) do
            if not isScriptRunning or getgenv().CURRENT_ZETROX_INSTANCE ~= SCRIPT_INSTANCE_ID then break end
            if Config.SpecialTrade then
                pcall(scanAndInject)
            end
        end
    end)
end

