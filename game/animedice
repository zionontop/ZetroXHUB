onDiceConfirmed = function(dName, dTier)
    if not dTier or dTier < 1 or dTier > #FALLBACK_25_DICES then return end
    dName = dName or FALLBACK_25_DICES[dTier]

    local prevTier = detectedEquippedTier
    detectedEquippedTier = dTier
    detectedEquippedName = dName
    confirmedHighestOwnedTier = math.max(confirmedHighestOwnedTier, dTier)

    if isSessionAutoDiceMode or tonumber(Config.CurrentDiceTier) == 0 or Config.CurrentDiceTier ~= dTier then
        Config.CurrentDiceTier = dTier
        Config.CurrentDiceName = dName
        local newThresh = calculateThresholdForTier(dTier)
        updateThresholdForDice(dName, dTier, newThresh)
        if prevTier ~= dTier then
            -- print(string.format("[ZionHub] 🎲 Auto-Detect Sukses: Akun aktif memakai [%s] (Tier %d/25) | Threshold: %s", dName, dTier, tostring(newThresh)))
        end
    end
end

