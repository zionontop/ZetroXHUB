local function getSlotUnitLevel(slotNum)
    if not slotNum then return nil end
    local sNum = tonumber(slotNum)
    if not sNum then return nil end

    -- 1. Cek dari DataController pState (100% Akurat Terverifikasi, 0ms Latency)
    local pState = getPlayerDataState()
    if pState and pState.Slots and pState.Inventory then
        local sData = pState.Slots[sNum] or pState.Slots[tostring(sNum)]
        if sData and sData.unitId then
            local unit = pState.Inventory[sData.unitId]
            if unit and unit.attributes and unit.attributes.level then
                local lvl = tonumber(unit.attributes.level)
                if lvl then
                    slotLevelsCache[sNum] = lvl
                    return lvl
                end
            end
        end
    end

    -- 2. Cek Cache dari Remote Event LevelUpSuccess
    if slotLevelsCache[sNum] then
        return slotLevelsCache[sNum]
    end

    -- 3. Fallback Cek Objek Fisik di Plot Player (workspace.Plots)
    local plot = getPlayerPlot()
    if plot then
        local slotObj = plot:FindFirstChild("Slot" .. tostring(sNum), true)
            or plot:FindFirstChild("Slot_" .. tostring(sNum), true)
            or plot:FindFirstChild(tostring(sNum), true)

        if not slotObj then
            for _, d in ipairs(plot:GetDescendants()) do
                if d:GetAttribute("Slot") == sNum or d:GetAttribute("SlotId") == sNum or d:GetAttribute("SlotIndex") == sNum then
                    slotObj = d
                    break
                end
            end
        end

        if slotObj then
            local attrLvl = slotObj:GetAttribute("Level") or slotObj:GetAttribute("Lv") or slotObj:GetAttribute("UnitLevel")
            if tonumber(attrLvl) then
                slotLevelsCache[sNum] = tonumber(attrLvl)
                return tonumber(attrLvl)
            end

            for _, desc in ipairs(slotObj:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Visible then
                    local txt = desc.Text
                    local matchLvl = txt:match("[Ll][Vv]%.?%s*(%d+)") or txt:match("[Ll][Ee][Vv][Ee][Ll]%s*:?%s*(%d+)")
                    if matchLvl and tonumber(matchLvl) then
                        local lvlFound = tonumber(matchLvl)
                        slotLevelsCache[sNum] = lvlFound
                        return lvlFound
                    end
                end
            end
        end
    end

    return nil
end

