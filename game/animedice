                local targetTierNum = ROMAN_TO_INT_MAP[romanTier] or tonumber(romanTier) or 1

                -- 2. Scan inventory untuk mendeteksi semua potion yang benar-benar dimiliki pemain saat ini
                local ownedPotions = scanOwnedPotions()

