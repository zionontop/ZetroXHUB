-- Universal GUI cleanup helper
local function purgeOldZetroXGuis()
    local function cleanParent(parent)
        if not parent then return end
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("ScreenGui") then
                local n = child.Name:lower()
                if n:find("zetrox") or n:find("obsidian") or child.Name == "ZetroX_ToggleScreenGui" then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end
    if gethui then pcall(function() cleanParent(gethui()) end) end
    pcall(function() cleanParent(game:GetService("CoreGui")) end)
    pcall(function() cleanParent(player:FindFirstChild("PlayerGui")) end)
end

