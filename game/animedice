local function getPlayerPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local claimed = plots:FindFirstChild("Claimed")
    if not claimed then return nil end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    for _, p in ipairs(claimed:GetChildren()) do
        if p.Name == player.Name or p.Name == tostring(player.UserId) then
            return p
        end
        if p:GetAttribute("Owner") == player.Name or p:GetAttribute("UserId") == player.UserId then
            return p
        end
        local ownerObj = p:FindFirstChild("Owner") or p:FindFirstChild("Player")
        if ownerObj and (ownerObj.Value == player or ownerObj.Value == player.Name or ownerObj.Value == player.UserId) then
            return p
        end
        for _, textObj in ipairs(p:GetDescendants()) do
            if textObj:IsA("TextLabel") and (textObj.Text == player.Name or textObj.Text == player.DisplayName) then
                return p
            end
        end
    end

    if hrp then
        local nearestPlot, minDist = nil, 80
        for _, p in ipairs(claimed:GetChildren()) do
            local cf = p:GetPivot()
            local dist = (cf.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearestPlot = p
            end
        end
        return nearestPlot
    end
    return nil
end

