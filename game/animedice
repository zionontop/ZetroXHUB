local function updateThresholdForDice(diceName, diceTier, forcedThreshold)
    if not Config.AutoSyncThresholdWithDice then return end

    local matchedThreshold = forcedThreshold or calculateThresholdForTier(diceTier)
    Config.SellThreshold = matchedThreshold

    if diceTier <= 1 or matchedThreshold <= 0 then
        -- Tier 1: Matikan auto-sell agar unit awal akun baru tidak terjual
        if Remotes.UpdateAutoSell then
            pcall(function() Remotes.UpdateAutoSell:FireServer(0) end)
        end
        -- print(string.format("[ZionHub] 🎲 Dadu Tier 1 (%s): Sell Threshold NONAKTIF (0) sampai upgrade ke Tier 2!", diceName or "Normal"))
        if uiRefs.thresholdLabel then
            uiRefs.thresholdLabel.Text = string.format("Threshold: Disabled (Tier 1: %s | Menunggu Tier 2)", diceName or "Normal")
        end
        if uiRefs.thresholdInput then
            uiRefs.thresholdInput.Text = "0 (Tier 1 No Sell)"
        end
        return
    end

    if Remotes.UpdateAutoSell then
        pcall(function() Remotes.UpdateAutoSell:FireServer(matchedThreshold) end)
    end

    -- print(string.format("[ZionHub] 🎲 Dadu tersinkron ke [%s] (Tier %d)! Auto-Sell Threshold diset ke %s", diceName or "Unknown", diceTier or 1, tostring(matchedThreshold)))
    if uiRefs.thresholdLabel then
        uiRefs.thresholdLabel.Text = string.format("Threshold: %s (Tier %d: %s | Step: %dT)",
            tostring(matchedThreshold), diceTier or 1, diceName or "Unknown", Config.SellThresholdTierStep or 4)
    end
    if uiRefs.thresholdInput then
        uiRefs.thresholdInput.Text = tostring(matchedThreshold)
    end
end

-- Callback terpusat saat dadu baru terkonfirmasi oleh game
onDiceConfirmed = function(dName, dTier)
    if not dTier or dTier < 1 or dTier > #FALLBACK_25_DICES then return end
    dName = dName or FALLBACK_25_DICES[dTier]

    local prevTier = detectedEquippedTier
    detectedEquippedTier = dTier
    detectedEquippedName = dName
    confirmedHighestOwnedTier = math.max(confirmedHighestOwnedTier, dTier)

    if isSessionAutoDiceMode or tonumber(Config.CurrentDiceTier) == 0 or Config.CurrentDiceTier ~= dTier then
        Config.CurrentDiceTier = dTier
        Config.CurrentDiceName = dName
        local newThresh = calculateThresholdForTier(dTier)
        updateThresholdForDice(dName, dTier, newThresh)
        if prevTier ~= dTier then
            -- print(string.format("[ZionHub] 🎲 Auto-Detect Sukses: Akun aktif memakai [%s] (Tier %d/25) | Threshold: %s", dName, dTier, tostring(newThresh)))
        end
    end
end

-- PERSISTENT MULTI-AKUN AUTO-SYNC (TIDAK PERNAH TERKUNCI PERMANEN KE TIER 1)
local isSessionAutoDiceMode = (tonumber(Config.CurrentDiceTier) == nil or tonumber(Config.CurrentDiceTier) <= 0)

local function syncEquippedDiceAndThreshold()
    if not isSessionAutoDiceMode then
        -- User sengaja mengunci angka manual di config (misal: CurrentDiceTier = 22)
        local cfgTier = math.clamp(tonumber(Config.CurrentDiceTier) or 1, 1, #FALLBACK_25_DICES)
        local cfgName = (Config.CurrentDiceName and Config.CurrentDiceName ~= "") 
            and Config.CurrentDiceName 
            or (FALLBACK_25_DICES[cfgTier] or ("Tier " .. tostring(cfgTier)))

        Config.CurrentDiceTier = cfgTier
        Config.CurrentDiceName = cfgName

        if Remotes.EquipDice and cfgName ~= "Normal" then
            pcall(function() Remotes.EquipDice:FireServer(cfgName) end)
            pcall(function() Remotes.EquipDice:FireServer(cfgName .. " Dice") end)
        end

        local targetThreshold = calculateThresholdForTier(cfgTier)
        if Config.SellThreshold ~= targetThreshold then
            updateThresholdForDice(cfgName, cfgTier, targetThreshold)
        end
        return
    end

    -- MODE 100% OTOMATIS: Scan terus menerus & Jangan biarkan terkunci di Tier 1 jika akun besar!
    local dName, dTier = detectEquippedDice()
    if dName and dTier and dTier > 0 then
        -- HANYA naikkan atau pasang dadu jika dTier >= CurrentDiceTier (Anti-Downgrade)
        local currT = tonumber(Config.CurrentDiceTier) or 0
        if dTier >= currT then
            Config.CurrentDiceTier = dTier
            Config.CurrentDiceName = dName
            if Remotes.EquipDice and dName ~= "Normal" then
                pcall(function() Remotes.EquipDice:FireServer(dName) end)
                pcall(function() Remotes.EquipDice:FireServer(dName .. " Dice") end)
            end
        end
    else
        if not Config.CurrentDiceTier or Config.CurrentDiceTier <= 0 then
            Config.CurrentDiceTier = 1
            Config.CurrentDiceName = "Normal"
        end
    end

    local activeTier = math.clamp(tonumber(Config.CurrentDiceTier) or 1, 1, #FALLBACK_25_DICES)
    local activeName = Config.CurrentDiceName or FALLBACK_25_DICES[activeTier] or "Normal"
    local targetThreshold = calculateThresholdForTier(activeTier)
    if Config.SellThreshold ~= targetThreshold then
        updateThresholdForDice(activeName, activeTier, targetThreshold)
    end
end

