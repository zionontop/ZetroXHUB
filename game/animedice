local function scanFrameworkForDice()
    local rep = game:GetService("ReplicatedStorage")
    local fwMod = rep:FindFirstChild("Framework")
    if not fwMod or not fwMod:IsA("ModuleScript") then return nil, nil, nil end
    local ok, fw = pcall(function() return require(fwMod) end)
    if not ok or typeof(fw) ~= "table" then return nil, nil, nil end

    local highestTier = 0
    local highestName = nil
    local function searchTable(tbl, depth)
        if depth > 4 or typeof(tbl) ~= "table" then return end
        for k, v in pairs(tbl) do
            if typeof(k) == "string" then
                local kl = k:lower()
                if kl:find("dice") or kl:find("equip") then
                    if typeof(v) == "string" then
                        local tNum, dName = getTierForDice(v)
                        if tNum and tNum > highestTier then
                            highestTier = tNum
                            highestName = dName
                        end
                    elseif typeof(v) == "number" and v >= 1 and v <= #FALLBACK_25_DICES then
                        if v > highestTier then
                            highestTier = v
                            highestName = FALLBACK_25_DICES[v]
                        end
                    end
                end
            end
            if typeof(v) == "table" then
                searchTable(v, depth + 1)
            end
        end
    end
    searchTable(fw, 1)

    if highestTier > 0 and highestName then
        return highestName, highestTier, "Framework"
    end
    return nil, nil, nil
end

