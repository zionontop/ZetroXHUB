-- UNIT DETECTOR & NAME-TO-UUID RESOLVER (Auto Trait & Grade Gems)
-- =============================================================================
local function scanAllUnits()
    local units = {}
    local seen = {}

    local genericNames = {
        ["frame"] = true, ["imageframe"] = true, ["scrollingframe"] = true,
        ["textlabel"] = true, ["textbutton"] = true, ["imagelabel"] = true,
        ["slot"] = true, ["uipadding"] = true, ["uicorner"] = true,
        ["uistroke"] = true, ["uigridlayout"] = true, ["uilistlayout"] = true,
        ["button"] = true, ["holder"] = true, ["content"] = true,
        ["icon"] = true, ["background"] = true, ["bg"] = true,
        ["template"] = true, ["card"] = true, ["item"] = true,
        ["model"] = true, ["part"] = true, ["humanoidrootpart"] = true,
        ["head"] = true, ["torso"] = true, ["character"] = true
    }

    local function isGenericName(n)
        if not n or #n < 2 then return true end
        local nLow = n:lower():gsub("%s+", "")
        if genericNames[nLow] then return true end
        if nLow:match("^slot%d+$") then return true end
        return false
    end

    local function checkContainer(inst)
        if not inst then return end
        local foundUUID = nil
        local foundName = nil

        -- A. Cek inst.Name
        local uName = tostring(inst.Name)
        local matchU = uName:match("(%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x)")
        if matchU then
            foundUUID = matchU
        elseif not isGenericName(uName) then
            foundName = uName
        end

        -- B. Cek Attributes
        pcall(function()
            for attrKey, attrVal in pairs(inst:GetAttributes()) do
                local valStr = tostring(attrVal)
                local uAttr = valStr:match("(%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x)")
                if uAttr then
                    foundUUID = uAttr
                end
                
                local kLow = tostring(attrKey):lower()
                if kLow:find("name") or kLow:find("unit") or kLow:find("type") or kLow:find("character") then
                    if not valStr:find("-") and not isGenericName(valStr) then
                        foundName = valStr
                    end
                end
            end
        end)

        -- C. Cek Children jika GUI / Model
        pcall(function()
            for _, child in ipairs(inst:GetChildren()) do
                local cName = tostring(child.Name)
                local uC = cName:match("(%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x)")
                if uC then foundUUID = uC end

                if child:IsA("StringValue") then
                    local uVal = tostring(child.Value):match("(%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x)")
                    if uVal then 
                        foundUUID = uVal 
                    elseif not isGenericName(child.Value) then
                        foundName = child.Value
                    end
                elseif child:IsA("TextLabel") or child:IsA("TextButton") then
                    local txt = child.Text
                    if txt and #txt > 1 and not isGenericName(txt) then
                        local txtLow = txt:lower()
                        if not txtLow:find("^%$") and not txtLow:find("lv") and not txtLow:find("equip") and not txtLow:find("roll") and not txtLow:find("lock") and not txtLow:find("upgrade") then
                            foundName = txt
                        end
                    end
                elseif child:IsA("Model") and not isGenericName(child.Name) then
                    foundName = child.Name
                end
            end
        end)

        if foundUUID and not seen[foundUUID] then
            seen[foundUUID] = true
            table.insert(units, {
                UUID = foundUUID,
                Name = foundName or "Unit"
            })
        end
    end

    -- 1. Scan Player Plot (Prioritas Unit Terpasang)
    local plot = getPlayerPlot()
    if plot then
        for _, desc in ipairs(plot:GetDescendants()) do
            checkContainer(desc)
        end
    end

    -- 2. Scan PlayerGui (Inventory / Unit Cards)
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        for _, desc in ipairs(pGui:GetDescendants()) do
            checkContainer(desc)
        end
    end

    -- 3. Scan Character & Backpack
    if player.Character then
