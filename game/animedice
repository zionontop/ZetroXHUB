registerUI(TradeGroup:AddButton({
    Text = "Send Request Trade",
    Func = function()
        local targetName = Config.TradeTargetPlayer
        if not targetName or targetName == "" or targetName == "No Players" then
            Library:Notify({
                Title = "ZetroX Hub",
                Description = "Please select a player first!",
                Time = 3,
            })
            return
        end
        local targetPlr = Players:FindFirstChild(targetName)
        if not targetPlr then
            Library:Notify({
                Title = "ZetroX Hub",
                Description = "Player not found in server!",
                Time = 3,
            })
            return
        end

        local reqRem = Remotes.RequestTrade
        if not reqRem then
            local rep = game:GetService("ReplicatedStorage")
            local net = rep:FindFirstChild("Network")
            local ts = net and net:FindFirstChild("TradeService")
            reqRem = ts and ts:FindFirstChild("RE") and ts.RE:FindFirstChild("RequestTrade")
            if reqRem then Remotes.RequestTrade = reqRem end
        end

        if reqRem then
            pcall(function() reqRem:FireServer(targetPlr) end)
            Library:Notify({
                Title = "ZetroX Hub",
                Description = "Trade request sent to " .. targetName .. "!",
                Time = 3,
            })
        else
            Library:Notify({
                Title = "ZetroX Hub",
                Description = "Trade remote not found!",
                Time = 3,
            })
        end
    end,
}), "Kirim Request Trade", "Send Request Trade")

