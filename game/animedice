-- Auto-Save Engine Terisolasi Per Akun (UserId)
local autoSaveQueued = false
local function triggerAutoSave()
    if Config.AutoSaveEnabled == false then return end
    if autoSaveQueued then return end
    autoSaveQueued = true
    task.delay(0.8, function()
        autoSaveQueued = false
        pcall(function()
            if writefile then
                if makefolder and isfolder and not isfolder("ZetroXHub") then
                    makefolder("ZetroXHub")
                end
                -- Buat salinan config tanpa CurrentDiceTier/Name agar akun lain tidak teracuni
                local cleanConfig = {}
                for k, v in pairs(Config) do
                    if k ~= "CurrentDiceTier" and k ~= "CurrentDiceName" then
                        cleanConfig[k] = v
                    end
                end
                local dataToSave = {
                    UserId = player.UserId,
                    Username = player.Name,
                    Language = Config.Language or "ID",
                    Config = cleanConfig
                }
                writefile(getUserConfigPath(), HttpService:JSONEncode(dataToSave))
            end
        end)
    end)
end
