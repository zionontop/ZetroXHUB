-- Helper untuk membaca stats lengkap akun (Money, Rolls, Gems, Trait, Ticket, Jackpot)
local function getLiveStats()
    local moneyStr = "$0"
    local rollsStr = "0"
    local gemsVal = 0
    local traitVal = 0
    local ticketsVal = 0
    local jackpotVal = 0

    -- 1. Baca langsung dari DataController jika tersedia
    local pState = getPlayerDataState()
    if pState then
        local b = pState.Balance or pState.Money
        if b then moneyStr = formatMoney(b) end
        if pState.Rolls then rollsStr = formatExact(pState.Rolls) end

        local inv = pState.Inventory
        if inv and typeof(inv) == "table" then
            if inv["Gems"] then gemsVal = (typeof(inv["Gems"]) == "table" and inv["Gems"].amount) or tonumber(inv["Gems"]) or 0 end
            if inv["Trait Reroll"] then traitVal = (typeof(inv["Trait Reroll"]) == "table" and inv["Trait Reroll"].amount) or tonumber(inv["Trait Reroll"]) or 0 end
            if traitVal == 0 and inv["Trait"] then traitVal = (typeof(inv["Trait"]) == "table" and inv["Trait"].amount) or tonumber(inv["Trait"]) or 0 end
            if inv["Tickets"] then ticketsVal = (typeof(inv["Tickets"]) == "table" and inv["Tickets"].amount) or tonumber(inv["Tickets"]) or 0 end

            for k, v in pairs(inv) do
                local kl = tostring(k):lower()
                if kl:find("jackpot") or kl:find("lucky spin") then
                    jackpotVal = (typeof(v) == "table" and v.amount) or tonumber(v) or jackpotVal
                end
            end
        end
        if jackpotVal == 0 and pState.JackpotRolls then
            jackpotVal = tonumber(pState.JackpotRolls) or 0
        elseif jackpotVal == 0 and pState.Jackpot then
            jackpotVal = tonumber(pState.Jackpot) or 0
        end
    end

    -- 2. Fallback leaderstats jika DataController belum terhubung
    if moneyStr == "$0" or rollsStr == "0" then
        pcall(function()
            local ls = player:FindFirstChild("leaderstats")
            if ls then
                for _, obj in ipairs(ls:GetChildren()) do
                    local n = obj.Name:lower()
                    if n == "money" or n == "cash" or n == "coins" or n == "balance" then
                        moneyStr = formatMoney(obj.Value)
                    elseif n:find("roll") then
                        rollsStr = formatExact(obj.Value)
                    end
                end
            end
        end)
    end

    return moneyStr, rollsStr, gemsVal, traitVal, jackpotVal, ticketsVal
end

