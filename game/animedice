local function isTowerEligible(towerData)
    if not towerData then return false end
    if not Config.TowersEnabled or not Config.TowersEnabled[towerData.ConfigKey] then
        return false
    end
    -- Auto-skip tier rendah HANYA JIKA diaktifkan oleh user di Config.SkipLowTierTowers (Default: FALSE agar semua tower dirotasi!)
    if Config.SkipLowTierTowers then
        local tier = tonumber(Config.CurrentDiceTier) or 1
        if towerData.ConfigKey == "DragonTower" and tier >= 10 then return false end
        if towerData.ConfigKey == "CursedTower" and tier >= 15 then return false end
        if towerData.ConfigKey == "PirateTower" and tier >= 20 then return false end
    end
    return true
end

local function getNextActiveTowerIdx(currentIdx)
    currentIdx = currentIdx or 1
    for i = 1, #TowerList do
        local checkIdx = ((currentIdx - 1 + i) % #TowerList) + 1
        local item = TowerList[checkIdx]
        if isTowerEligible(item) then
            return checkIdx
        end
    end
    if isTowerEligible(TowerList[currentIdx]) then
        return currentIdx
    end
    return nil
end

