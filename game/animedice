-- Realtime update loop untuk Session Timer & Ping
task.spawn(function()
    while task.wait(1) do
        if Library.Unloaded then break end
        pcall(function()
            local elapsed = os.time() - sessionStartTime
            local hrs = math.floor(elapsed / 3600)
            local mins = math.floor((elapsed % 3600) / 60)
            local secs = elapsed % 60
            local sFormatted = (hrs > 0 and string.format("%dh %dm %ds", hrs, mins, secs) or string.format("%dm %ds", mins, secs))
            sessionLabel:SetText(string.format("Session - <font color=\"#f1c40f\">%s</font>", sFormatted))

            local curPlayers = #game:GetService("Players"):GetPlayers()
            local maxPlayers = game:GetService("Players").MaxPlayers
            playersLabel:SetText(string.format("Players - <font color=\"#2ecc71\">%d/%d</font>", curPlayers, maxPlayers))

            local pingVal = 0
            local stats = game:GetService("Stats")
            local netStats = stats:FindFirstChild("Network")
            local sStats = netStats and netStats:FindFirstChild("ServerStatsItem")
            local pingItem = sStats and sStats:FindFirstChild("Data Ping")
            if pingItem then
                pingVal = math.floor(tonumber(pingItem:GetValueString():match("[%d%.]+")) or 0)
            else
                pingVal = math.floor((lPlayer:GetNetworkPing() or 0) * 1000)
            end
            pingLabel:SetText(string.format("Ping - <font color=\"#f1c40f\">%d ms</font>", pingVal))
        end)
    end
end)



