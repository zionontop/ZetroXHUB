local logoDragging = false
local logoStartMouse = Vector2.zero
local logoStartPos = UDim2.new()
local logoDist = 0
local logoConn = nil

FloatButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        logoDragging = true
        logoStartMouse = UserInputService:GetMouseLocation()
        logoStartPos = FloatButton.Position
        logoDist = 0
        if logoConn then logoConn:Disconnect() end
        logoConn = RunService.RenderStepped:Connect(function()
            if logoDragging then
                local currentMouse = UserInputService:GetMouseLocation()
                local delta = currentMouse - logoStartMouse
                logoDist = delta.Magnitude
                FloatButton.Position = UDim2.new(
                    logoStartPos.X.Scale, logoStartPos.X.Offset + delta.X,
                    logoStartPos.Y.Scale, logoStartPos.Y.Offset + delta.Y
                )
            else
                if logoConn then logoConn:Disconnect() end
            end
        end)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if logoDragging then
            logoDragging = false
            if logoConn then logoConn:Disconnect() end
            if logoDist < 6 then Library:Toggle() end
        end
    end
end)

