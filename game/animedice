-- Helper: Hitung estimasi penghasilan per detik (Income/s) resmi untuk 1 unit
local function getUnitRawIncome(uData)
    if not uData then return 0 end
    local baseIncome = 0

    if not UnitConfig then
        pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local fw = RS:FindFirstChild("Framework")
            local feats = fw and fw:FindFirstChild("Features")
            local inv = feats and feats:FindFirstChild("Inventory")
            local kinds = inv and inv:FindFirstChild("Kinds")
            local uKind = kinds and kinds:FindFirstChild("Unit")
            local uCfg = uKind and uKind:FindFirstChild("UnitConfig")
            if uCfg then UnitConfig = require(uCfg) end
        end)
    end

    local uName = uData.name or uData.Name
    local attrs = uData.attributes or uData.Attributes or {}

    -- Panggil fungsi resmi entry.income(attributes) bawaan game
    -- Game SUDAH otomatis menghitung level, mutasi, grade, dan trait secara lengkap di dalamnya.
    pcall(function()
        if UnitConfig and UnitConfig.entries and uName then
            local entry = UnitConfig.entries[uName]
            if entry then
                if type(entry.income) == "function" then
                    local ok, val = pcall(entry.income, attrs)
                    if ok and tonumber(val) then baseIncome = tonumber(val) end
                elseif tonumber(entry.income) then
                    baseIncome = tonumber(entry.income)
                elseif tonumber(entry.baseIncome) then
                    baseIncome = tonumber(entry.baseIncome)
                elseif tonumber(entry.moneyPerSecond) then
                    baseIncome = tonumber(entry.moneyPerSecond)
                end
            end
        end
    end)

    if baseIncome <= 0 and attrs then
        baseIncome = tonumber(attrs.income or attrs.baseIncome or attrs.mps) or 0
    end
    if baseIncome <= 0 and uData.income then
        baseIncome = tonumber(uData.income) or 0
    end

    -- entry.income(attributes) resmi sudah mencakup seluruh multiplier (Level, Mutasi, Grade, Trait).
    -- Jangan kalikan gradeMult/traitMult lagi agar tidak terjadi double-multiplication (seperti 10x menjadi 100x).
    return math.max(baseIncome, 0)
end

local function formatUnitIncome(rawIncome, uData)
    if rawIncome and rawIncome > 0 then
        return formatMoney(rawIncome) .. "/s"
    end
    return "$0/s"
end

-- Scanner Unit Inventory Akurat (Hanya Unit murni, memfilter Potion / Currency)
local function scanInventoryUnits()
    local list = {}
    local pState = getPlayerDataState()

    if not UnitConfig then
        pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local fw = RS:FindFirstChild("Framework")
            local feats = fw and fw:FindFirstChild("Features")
            local inv = feats and feats:FindFirstChild("Inventory")
            local kinds = inv and inv:FindFirstChild("Kinds")
            local uKind = kinds and kinds:FindFirstChild("Unit")
            local uCfg = uKind and uKind:FindFirstChild("UnitConfig")
            if uCfg then UnitConfig = require(uCfg) end
        end)
    end

    if pState and pState.Inventory and typeof(pState.Inventory) == "table" then
        for uId, uData in pairs(pState.Inventory) do
            if typeof(uData) == "table" and (uData.name or uData.Name) then
                local uName = tostring(uData.name or uData.Name)
                local isUnit = false

                -- Validasi ketat: cek UnitConfig.entries
                if UnitConfig and UnitConfig.entries then
                    local entry = UnitConfig.entries[uName]
                    if entry and (entry.kind == "Unit" or entry.rarity) then
                        isUnit = true
                    end
                else
                    if not ALL_GAME_POTIONS[uName] 
                       and uName ~= "Gems" 
                       and uName ~= "Trait Reroll" 
                       and uName ~= "Tickets" 
                       and not uName:find("Potion") 
                       and not uName:find("Ticket") then
                        isUnit = true
                    end
                end

                if isUnit then
                    table.insert(list, {
                        UUID = tostring(uId),
                        Name = uName,
                        Attributes = uData.attributes or {},
                        Grade = (uData.attributes and uData.attributes.grade) or uData.grade or "None",
                        Trait = (uData.attributes and uData.attributes.trait) or uData.trait or "None",
                        Data = uData
                    })
                end
            end
        end
    end
    return list
end

local UnitDisplayMap = {}       -- [displayName] = UUID
local UnitUUIDMap = {}          -- [UUID] = displayName
local CurrentUnitDisplayList = {}

local function refreshUnitDropdownList()
    UnitDisplayMap = {}
    UnitUUIDMap = {}
    CurrentUnitDisplayList = {}

    local units = scanInventoryUnits()

    -- 1. Hitung raw income & format string untuk tiap unit
    for _, u in ipairs(units) do
        u.rawIncome = getUnitRawIncome(u.Data or u)
        u.incomeStr = formatUnitIncome(u.rawIncome, u.Data or u)
    end

    -- 2. SORTING BERDASARKAN INCOME TERTINGGI KE TERENDAH
    table.sort(units, function(a, b)
        if a.rawIncome ~= b.rawIncome then
            return a.rawIncome > b.rawIncome
        end
        return a.Name < b.Name
    end)

    -- 3. Hitung kemunculan nama agar unit kembar diberi tag (#1, #2, dst)
    local nameOccurrences = {}
    for _, u in ipairs(units) do
        nameOccurrences[u.Name] = (nameOccurrences[u.Name] or 0) + 1
    end

    local currentCount = {}
    for _, u in ipairs(units) do
        local displayName = u.Name
        if nameOccurrences[u.Name] > 1 then
            currentCount[u.Name] = (currentCount[u.Name] or 0) + 1
            displayName = string.format("%s #%d (%s)", u.Name, currentCount[u.Name], u.incomeStr)
        else
            displayName = string.format("%s (%s)", u.Name, u.incomeStr)
        end

        UnitDisplayMap[displayName] = u.UUID
        UnitUUIDMap[u.UUID] = displayName
        table.insert(CurrentUnitDisplayList, displayName)
    end

    if #CurrentUnitDisplayList == 0 then
        table.insert(CurrentUnitDisplayList, "(Tidak Ada Unit)")
        UnitDisplayMap["(Tidak Ada Unit)"] = ""
    end

    return CurrentUnitDisplayList
end

