local function applyFPSCap(targetFPS)
    local fps = tonumber(targetFPS)
    if not fps or fps <= 0 then return end
    
    if type(setfpscap) == "function" then
        pcall(setfpscap, fps)
    end
    if getgenv and type(getgenv().setfpscap) == "function" then
        pcall(getgenv().setfpscap, fps)
    end
    if type(set_fps_cap) == "function" then
        pcall(set_fps_cap, fps)
    end
    if getgenv and type(getgenv().set_fps_cap) == "function" then
        pcall(getgenv().set_fps_cap, fps)
    end
    if syn and type(syn.set_fps_cap) == "function" then
        pcall(syn.set_fps_cap, fps)
    end
end

