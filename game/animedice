-- Helper: Hitung chance / rarity resmi unit (termasuk mutasi & varian)
local function getUnitChance(unitData)
    if not unitData or not unitData.name then return 0 end
    local entry = UnitConfig and UnitConfig.entries and UnitConfig.entries[unitData.name]
    if not entry then return 0 end
    local chance = 0
    if type(entry.chance) == "function" then
        local ok, val = pcall(function() return entry.chance(unitData.attributes) end)
        if ok and val then chance = tonumber(val) or 0 end
        if chance == 0 then
            local ok2, val2 = pcall(function() return entry.chance() end)
            if ok2 and val2 then chance = tonumber(val2) or 0 end
        end
    else
        chance = tonumber(entry.chance) or 0
    end
    return chance
end

local function getPlayerDataState()
    if not DataController then
        pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local Framework = RS:FindFirstChild("Framework")
            local Features = Framework and Framework:FindFirstChild("Features")
            local DataMod = Features and Features:FindFirstChild("Data") and Features.Data:FindFirstChild("DataController")
            if DataMod then DataController = require(DataMod) end
        end)
    end
    if not DataController then return nil end
    return DataController.___X or DataController.___C
end

