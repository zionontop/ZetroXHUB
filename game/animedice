local isSessionAutoDiceMode = (tonumber(Config.CurrentDiceTier) == nil or tonumber(Config.CurrentDiceTier) <= 0)

local function syncEquippedDiceAndThreshold()
    if not isSessionAutoDiceMode then
        -- User sengaja mengunci angka manual di config (misal: CurrentDiceTier = 22)
        local cfgTier = math.clamp(tonumber(Config.CurrentDiceTier) or 1, 1, #FALLBACK_25_DICES)
        local cfgName = (Config.CurrentDiceName and Config.CurrentDiceName ~= "") 
            and Config.CurrentDiceName 
            or (FALLBACK_25_DICES[cfgTier] or ("Tier " .. tostring(cfgTier)))

        Config.CurrentDiceTier = cfgTier
        Config.CurrentDiceName = cfgName

        if Remotes.EquipDice and cfgName ~= "Normal" then
            pcall(function() Remotes.EquipDice:FireServer(cfgName) end)
            pcall(function() Remotes.EquipDice:FireServer(cfgName .. " Dice") end)
        end

        local targetThreshold = calculateThresholdForTier(cfgTier)
        if Config.SellThreshold ~= targetThreshold then
            updateThresholdForDice(cfgName, cfgTier, targetThreshold)
        end
        return
    end

    -- MODE 100% OTOMATIS: Scan terus menerus & Jangan biarkan terkunci di Tier 1 jika akun besar!
    local dName, dTier = detectEquippedDice()
    if dName and dTier and dTier > 0 then
        -- HANYA naikkan atau pasang dadu jika dTier >= CurrentDiceTier (Anti-Downgrade)
        local currT = tonumber(Config.CurrentDiceTier) or 0
        if dTier >= currT then
            Config.CurrentDiceTier = dTier
            Config.CurrentDiceName = dName
            if Remotes.EquipDice and dName ~= "Normal" then
                pcall(function() Remotes.EquipDice:FireServer(dName) end)
                pcall(function() Remotes.EquipDice:FireServer(dName .. " Dice") end)
            end
        end
    else
        if not Config.CurrentDiceTier or Config.CurrentDiceTier <= 0 then
            Config.CurrentDiceTier = 1
            Config.CurrentDiceName = "Normal"
        end
    end

    local activeTier = math.clamp(tonumber(Config.CurrentDiceTier) or 1, 1, #FALLBACK_25_DICES)
    local activeName = Config.CurrentDiceName or FALLBACK_25_DICES[activeTier] or "Normal"
    local targetThreshold = calculateThresholdForTier(activeTier)
    if Config.SellThreshold ~= targetThreshold then
        updateThresholdForDice(activeName, activeTier, targetThreshold)
    end
end

