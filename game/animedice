    if player:FindFirstChild("Backpack") then
        for _, desc in ipairs(player.Backpack:GetChildren()) do
            if desc:IsA("Tool") then
                local t, n = getTierForDice(desc.Name)
                if t and t > 0 then return n, t end
            end
        end
    end

    -- 3. Cek Player Children & leaderstats
    for _, obj in ipairs(player:GetChildren()) do
        if obj:IsA("ValueBase") then
            local t, n = getTierForDice(tostring(obj.Value))
            if t and t > 0 then return n, t end
            local numVal = tonumber(obj.Value)
            if numVal and numVal >= 1 and numVal <= #FALLBACK_25_DICES then
                local oLower = obj.Name:lower()
                if oLower:find("dice") or oLower:find("equip") or oLower:find("tier") then
                    return FALLBACK_25_DICES[numVal], numVal
                end
            end
        elseif obj.Name == "leaderstats" or obj.Name == "Data" or obj.Name == "Stats" then
            for _, subVal in ipairs(obj:GetChildren()) do
                if subVal:IsA("ValueBase") then
                    local t, n = getTierForDice(tostring(subVal.Value))
                    if t and t > 0 then return n, t end
                    local numVal = tonumber(subVal.Value)
                    if numVal and numVal >= 1 and numVal <= #FALLBACK_25_DICES then
                        local sLower = subVal.Name:lower()
                        if sLower:find("dice") or sLower:find("equip") or sLower:find("tier") then
                            return FALLBACK_25_DICES[numVal], numVal
                        end
                    end
                end
            end
        end
    end

    -- 4. Cek Kartu Dice Shop yang Ter-render Nyata di Layar
    local cards = scanRealDiceShopCards()
    if #cards > 0 then
        for _, c in ipairs(cards) do
            if c.IsEquipped and c.Tier and c.Tier > 0 then
                return c.Name, c.Tier
            end
        end
    end

    -- 5. Cek Label HUD di Layar Karakter
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        for _, lbl in ipairs(pGui:GetDescendants()) do
            if lbl.Name:find("Zion") or (lbl.Parent and lbl.Parent.Name:find("Zion")) then continue end
            if screenGui and lbl:IsDescendantOf(screenGui) then continue end
            if lbl:FindFirstAncestorWhichIsA("ScrollingFrame") then continue end

            if lbl:IsA("TextLabel") and lbl.Visible and typeof(lbl.Text) == "string" and lbl.Text ~= "" and #lbl.Text <= 30 then
                local t, n = getTierForDice(lbl.Text)
                if t and t > 0 then
                    local p = lbl.Parent
                    local isTrulyVisible = true
                    while p and p:IsA("GuiObject") do
                        if not p.Visible then
                            isTrulyVisible = false
                            break
                        end
                        p = p.Parent
                    end
                    if isTrulyVisible then
                        return n, t
                    end
                end
            end
        end
    end

    -- 6. Kembalikan state internal terkonfirmasi (Default: Tier 1 Normal)
    local cTier = detectedEquippedTier or (tonumber(Config.CurrentDiceTier) > 0 and tonumber(Config.CurrentDiceTier)) or 1
    local cName = detectedEquippedName or FALLBACK_25_DICES[cTier] or "Normal"
    return cName, cTier
end

-- Listener Data RemoteEvent Game (Auto update saat server kirim data baru)
local function parseGameDataRecursive(tbl, depth)
    if depth > 5 or typeof(tbl) ~= "table" then return end
    for k, v in pairs(tbl) do
        local kStr = tostring(k):lower()
        if kStr:find("equip") or kStr == "dice" or kStr == "currentdice" or kStr == "activedice" then
            if typeof(v) == "string" then
                local tNum, dName = getTierForDice(v)
                if tNum and tNum >= 1 and tNum <= #FALLBACK_25_DICES then
                    -- print(string.format("[ZionHub] 🎲 Server Push: Dadu terpasang -> %s (Tier %d)", dName, tNum))
                    if onDiceConfirmed then onDiceConfirmed(dName, tNum) end
                end
            elseif typeof(v) == "number" and v >= 1 and v <= #FALLBACK_25_DICES then
                local dName = FALLBACK_25_DICES[v]
                -- print(string.format("[ZionHub] 🎲 Server Push: Dadu terpasang -> %s (Tier %d)", dName, v))
                if onDiceConfirmed then onDiceConfirmed(dName, v) end
            end
        end

        if kStr:find("owned") or kStr:find("inventory") or kStr:find("dices") then
            if typeof(v) == "table" then
                for subK, subV in pairs(v) do
                    local cand = (typeof(subV) == "string" and subV) or (typeof(subK) == "string" and subK) or nil
                    if cand then
                        local tNum = getTierForDice(cand)
                        if tNum and tNum > confirmedHighestOwnedTier then
                            confirmedHighestOwnedTier = tNum
                        end
                    end
                end
            end
        end

        if typeof(v) == "table" then
            parseGameDataRecursive(v, depth + 1)
        end
    end
end

