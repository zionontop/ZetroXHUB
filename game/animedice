local redeemedCodesCache = {}

local function claimAllCodes()
    if not Remotes.RedeemCode then
        for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
            if (desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction")) and desc.Name == "RedeemCode" then
                Remotes.RedeemCode = desc
                break
            end
        end
    end
    if not Remotes.RedeemCode then
        -- print("[ZionHub] ⚠️ Remote RedeemCode belum ditemukan di ReplicatedStorage.")
        return false, 0
    end

    local allCodesToTry = {}
    local seen = {}

    -- 1. Daftar Game Codes Bawaan
    for _, c in ipairs(GAME_CODES) do
        local upper = c:upper():gsub("%s+", "")
        if not seen[upper] then
            seen[upper] = true
            table.insert(allCodesToTry, upper)
        end
    end

    -- 2. Custom Codes dari Input Pengguna
    for _, c in ipairs(Config.CustomCodes) do
        local upper = c:upper():gsub("%s+", "")
        if not seen[upper] then
            seen[upper] = true
            table.insert(allCodesToTry, upper)
        end
    end

    -- 3. Dynamic Scanner dari PlayerGui jika ada info update / promo codes
    pcall(function()
        local pGui = player:FindFirstChild("PlayerGui")
        if pGui then
            for _, desc in ipairs(pGui:GetDescendants()) do
                if desc:IsA("TextLabel") or desc:IsA("TextBox") then
                    local txt = desc.Text
                    if txt and (txt:lower():find("code") or txt:lower():find("update")) then
                        for word in txt:gmatch("([%a%d_!]+)") do
                            if #word >= 3 and #word <= 20 then
                                local upper = word:upper()
                                if not seen[upper] then
                                    seen[upper] = true
                                    table.insert(allCodesToTry, upper)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    local processed = 0
    for _, code in ipairs(allCodesToTry) do
        if not redeemedCodesCache[code] then
            pcall(function()
                if Remotes.RedeemCode:IsA("RemoteEvent") then
                    Remotes.RedeemCode:FireServer(code)
                elseif Remotes.RedeemCode:IsA("RemoteFunction") then
                    Remotes.RedeemCode:InvokeServer(code)
                end
            end)
            redeemedCodesCache[code] = true
            processed = processed + 1
            task.wait(0.3)
        end
    end

    if uiRefs.codeStatusLabel then
        uiRefs.codeStatusLabel.Text = string.format("Kode Terklaim: %d / %d", processed, #allCodesToTry)
    end
    -- print(string.format("[ZionHub] 🎁 Auto Redeem Codes selesai: %d kode baru dicoba.", processed))
    return true, processed
end

-- Format angka uang dengan suffix Anime Dice (k, m, b, t, qa, qi, sx, sp, dst)
local MONEY_SUFFIXES = {
    "", "k", "m", "b", "t", "qa", "qi", "sx", "sp", "oc", "no", "dc", 
    "ud", "dd", "td", "qd", "qn", "sd", "spd", "od", "nd", "vg"
}

local function formatExact(n)
    local formatted = tostring(math.floor(tonumber(n) or 0))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return formatted
end

local function formatWithCommas(val)
    if not val then return "0" end
    local s = tostring(math.floor(val))
    return s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function formatCompactNumber(val)
    if not val or val <= 0 then return "0" end
    if val < 1000 then return tostring(math.floor(val)) end
    local exp = math.floor(math.log(math.max(val, 1), 10) / 3)
    exp = math.clamp(exp, 0, #MONEY_SUFFIXES - 1)
    local div = 10 ^ (exp * 3)
    local n = val / div
    if n >= 100 then
        return string.format("%.0f%s", n, MONEY_SUFFIXES[exp + 1])
    elseif n >= 10 then
        local s = string.format("%.1f%s", n, MONEY_SUFFIXES[exp + 1])
        return s:gsub("%.0$", "")
    else
        local s = string.format("%.2f%s", n, MONEY_SUFFIXES[exp + 1])
        return s:gsub("%.00$", ""):gsub("(%.%d)0$", "%1")
    end
end

local function formatMoney(val)
    if not val then return "$0" end
    if typeof(val) == "string" then
        local clean = val:gsub("%s+", "")
        if clean:find("^%$") then return clean end
        return "$" .. clean
    end
    if typeof(val) == "number" then
        if val < 1000 then return "$" .. tostring(math.floor(val)) end
        local exp = math.floor(math.log(math.max(val, 1), 10) / 3)
        exp = math.clamp(exp, 0, #MONEY_SUFFIXES - 1)
        local div = 10 ^ (exp * 3)
        local n = val / div
        if n >= 100 then
            return string.format("$%.0f%s", n, MONEY_SUFFIXES[exp + 1])
        elseif n >= 10 then
            return string.format("$%.1f%s", n, MONEY_SUFFIXES[exp + 1])
        else
            return string.format("$%.2f%s", n, MONEY_SUFFIXES[exp + 1])
        end
    end
    return "$" .. tostring(val)
end

-- Helper untuk membaca stats lengkap akun (Money, Rolls, Gems, Trait, Ticket, Jackpot)
local function getLiveStats()
    local moneyStr = "$0"
    local rollsStr = "0"
    local gemsVal = 0
    local traitVal = 0
    local ticketsVal = 0
    local jackpotVal = 0

    -- 1. Baca langsung dari DataController jika tersedia
    local pState = getPlayerDataState()
    if pState then
        local b = pState.Balance or pState.Money
        if b then moneyStr = formatMoney(b) end
        if pState.Rolls then rollsStr = formatExact(pState.Rolls) end

        local inv = pState.Inventory
        if inv and typeof(inv) == "table" then
            if inv["Gems"] then gemsVal = (typeof(inv["Gems"]) == "table" and inv["Gems"].amount) or tonumber(inv["Gems"]) or 0 end
            if inv["Trait Reroll"] then traitVal = (typeof(inv["Trait Reroll"]) == "table" and inv["Trait Reroll"].amount) or tonumber(inv["Trait Reroll"]) or 0 end
            if traitVal == 0 and inv["Trait"] then traitVal = (typeof(inv["Trait"]) == "table" and inv["Trait"].amount) or tonumber(inv["Trait"]) or 0 end
            if inv["Tickets"] then ticketsVal = (typeof(inv["Tickets"]) == "table" and inv["Tickets"].amount) or tonumber(inv["Tickets"]) or 0 end

            for k, v in pairs(inv) do
                local kl = tostring(k):lower()
                if kl:find("jackpot") or kl:find("lucky spin") then
                    jackpotVal = (typeof(v) == "table" and v.amount) or tonumber(v) or jackpotVal
                end
            end
        end
        if jackpotVal == 0 and pState.JackpotRolls then
            jackpotVal = tonumber(pState.JackpotRolls) or 0
        elseif jackpotVal == 0 and pState.Jackpot then
            jackpotVal = tonumber(pState.Jackpot) or 0
        end
    end

    -- 2. Fallback leaderstats jika DataController belum terhubung
    if moneyStr == "$0" or rollsStr == "0" then
        pcall(function()
            local ls = player:FindFirstChild("leaderstats")
            if ls then
                for _, obj in ipairs(ls:GetChildren()) do
                    local n = obj.Name:lower()
                    if n == "money" or n == "cash" or n == "coins" or n == "balance" then
                        moneyStr = formatMoney(obj.Value)
                    elseif n:find("roll") then
                        rollsStr = formatExact(obj.Value)
                    end
                end
            end
        end)
    end

    return moneyStr, rollsStr, gemsVal, traitVal, jackpotVal, ticketsVal
end

-- 🌟 AUTO EQUIP BEST RARITY & AUTO SELL JUNK BAG UNITS
-- =============================================================================
local isEquippingBestRarity = false
local function autoEquipBestRarityUnits()
    if isEquippingBestRarity then return end
    local intRem = Remotes.InteractSlot
    local equipRem = Remotes.UnitEquip
    if not intRem then return end

    local pState = getPlayerDataState()
    if not pState or not pState.Inventory then return end

    isEquippingBestRarity = true
    pcall(function()
        local maxSlots = math.max(6, tonumber(Config.MaxPlotSlots) or 30)
        local equippedBySlot = {}
        local protectedIds = {}
        local totalSlots = 0

        if pState.Slots then
            for sIdx, sData in pairs(pState.Slots) do
                local slotNum = tonumber(sIdx)
                if slotNum and typeof(sData) == "table" and sData.unitId then
                    local uId = tostring(sData.unitId)
                    local uData = pState.Inventory and pState.Inventory[uId]
                    equippedBySlot[slotNum] = {
                        slot = slotNum,
                        unitId = uId,
                        name = uData and uData.name or "Unknown",
                        chance = getUnitChance(uData),
                        level = uData and uData.attributes and uData.attributes.level or 1,
                        mutation = uData and uData.attributes and uData.attributes.mutation or "None"
                    }
                    protectedIds[uId] = true
                    totalSlots = math.max(totalSlots, slotNum)
                end
            end
        end

        if pState.TowerTeam then
            for _, tUnit in pairs(pState.TowerTeam) do
                if typeof(tUnit) == "string" then protectedIds[tUnit] = true
                elseif typeof(tUnit) == "table" then
                    local tid = tUnit.unitId or tUnit.id or tUnit.UUID
                    if tid then protectedIds[tostring(tid)] = true end
                end
            end
        end

        local bagUnits = {}
        for uId, uData in pairs(pState.Inventory) do
            local idStr = tostring(uId)
            if typeof(uData) == "table" and uData.name and not protectedIds[idStr] then
                table.insert(bagUnits, {
                    id = idStr,
                    name = uData.name,
                    chance = getUnitChance(uData),
                    level = uData.attributes and uData.attributes.level or 1,
                    mutation = uData.attributes and uData.attributes.mutation or "None"
                })
            end
        end

        table.sort(bagUnits, function(a, b)
            if a.chance ~= b.chance then
                return a.chance > b.chance
            end
            return a.level > b.level
        end)

        local replacements = {}
        for _, bagU in ipairs(bagUnits) do
            local worstSlotNum = nil
            local worstSlotChance = bagU.chance
            for s = 1, math.max(6, totalSlots) do
                local sl = equippedBySlot[s]
                if not sl then
                    worstSlotNum = s
                    worstSlotChance = -1
                    break
                elseif sl.chance < worstSlotChance then
                    worstSlotChance = sl.chance
                    worstSlotNum = s
                end
            end

            if worstSlotNum then
                table.insert(replacements, {
                    slot = worstSlotNum,
                    oldUnit = equippedBySlot[worstSlotNum],
                    newUnit = bagU
                })
                equippedBySlot[worstSlotNum] = {
                    slot = worstSlotNum,
                    unitId = bagU.id,
                    name = bagU.name,
                    chance = bagU.chance,
                    level = bagU.level,
                    mutation = bagU.mutation
                }
            end
        end

        for _, rep in ipairs(replacements) do
            if rep.oldUnit then
                pcall(function() intRem:FireServer(rep.slot) end)
                task.wait(0.25)
            end
            pcall(function() intRem:FireServer(rep.slot, rep.newUnit.id) end)
            if equipRem then pcall(function() equipRem:InvokeServer(rep.newUnit.id) end) end
            task.wait(0.25)
        end
    end)
    isEquippingBestRarity = false
end

local isSellingBagUnits = false
local function autoSellBagUnitsBelowThreshold()
    if isSellingBagUnits then return end
    local sellRem = Remotes.SellEquipped
    local equipRem = Remotes.UnitEquip
    if not sellRem or not equipRem then return end

    local currentThreshold = tonumber(Config.SellThreshold) or 0
    if currentThreshold <= 0 then return end

    local pState = getPlayerDataState()
    if not pState or not pState.Inventory then return end

    isSellingBagUnits = true
    pcall(function()
        local protectedUnitIds = {}
        if pState.Slots then
            for _, sData in pairs(pState.Slots) do
                if typeof(sData) == "table" and sData.unitId then
                    protectedUnitIds[tostring(sData.unitId)] = true
                end
            end
        end

        if pState.TowerTeam then
            for _, tUnit in pairs(pState.TowerTeam) do
                if typeof(tUnit) == "string" then protectedUnitIds[tUnit] = true
                elseif typeof(tUnit) == "table" then
                    local tid = tUnit.unitId or tUnit.id or tUnit.UUID
                    if tid then protectedUnitIds[tostring(tid)] = true end
                end
            end
        end

        local unitsToSell = {}
        for itemId, item in pairs(pState.Inventory) do
            local idStr = tostring(itemId)
            if typeof(item) == "table" and item.attributes and item.name then
                if not protectedUnitIds[idStr] then
                    local isLocked = item.locked or item.favorite
                    if item.attributes and (item.attributes.locked or item.attributes.favorite) then
                        isLocked = true
                    end

                    if not isLocked then
                        local unitChance = getUnitChance(item)
                        if unitChance and unitChance > 0 and unitChance < currentThreshold then
                            table.insert(unitsToSell, {
                                id = idStr,
                                name = item.name,
                                chance = unitChance
                            })
                        end
                    end
                end
            end
        end

        if #unitsToSell > 0 then
            for i, unit in ipairs(unitsToSell) do
                pcall(function() equipRem:InvokeServer(unit.id) end)
                task.wait(0.12)
                pcall(function() sellRem:InvokeServer() end)
                task.wait(0.12)
            end

            task.wait(0.3)
            pcall(autoEquipBestRarityUnits)
        end
    end)
    isSellingBagUnits = false
end

