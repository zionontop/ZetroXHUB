-- DYNAMIC DICE SYNC DARI MODULE RESMI GAME (ANTI-HARDCODE)
-- Path: game:GetService("ReplicatedStorage").Framework.Features.Rolling.Dice
-- =============================================================================
local function syncDiceFromGameModule()
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local fw = RS:FindFirstChild("Framework")
        local feats = fw and fw:FindFirstChild("Features")
        local rolling = feats and feats:FindFirstChild("Rolling")
        local diceScript = rolling and rolling:FindFirstChild("Dice")
        if not diceScript then return end

        local ok, diceMod = pcall(require, diceScript)
        if not ok or not diceMod or not diceMod.GetAll then return end

        local allDice = diceMod.GetAll()
        if not allDice or typeof(allDice) ~= "table" then return end

        local extracted = {}
        for dName, dData in pairs(allDice) do
            if typeof(dData) == "table" and dName ~= "Basic" then
                local price = tonumber(dData.price) or (dName == "Normal" and 1 or 0)
                table.insert(extracted, {
                    name = dName,
                    price = price,
                    luck = tonumber(dData.luck) or 1
                })
            end
        end

        table.sort(extracted, function(a, b)
            return a.price < b.price
        end)

        for idx, item in ipairs(extracted) do
            item.tier = idx
            DICE_ORDERED[idx] = item
            FALLBACK_25_DICES[idx] = item.name

            local lower = item.name:lower()
            if not DICE_NAME_TO_TIER[lower] then
                DICE_NAME_TO_TIER[lower] = { tier = idx, name = item.name }
            else
                DICE_NAME_TO_TIER[lower].tier = idx
                DICE_NAME_TO_TIER[lower].name = item.name
            end
        end
    end)
end
pcall(syncDiceFromGameModule)

-- Helper resmi untuk mendapatkan Tier & Nama Resmi Dadu (Bilingual ID/EN Support)
local function getTierForDice(name)
    if not name or typeof(name) ~= "string" then return nil, nil end
    local raw = name:lower()
    if #raw > 45 then return nil, nil end
    if raw:find("defeat") or raw:find("attack") or raw:find("quest") or raw:find("kill") or raw:find("boss") then
        return nil, nil
    end

    local clean = raw:gsub("dice%s*:%s*", ""):gsub("%s*dice%s*", " ")
    clean = clean:gsub("dadu%s*:%s*", ""):gsub("%s*dadu%s*", " ")
    clean = clean:gsub("%[tier%s*%d+%]", ""):gsub("%(tier%s*%d+%)", ""):gsub("tier%s*%d+", "")
    if clean:find("|") then clean = clean:split("|")[1] end
    if clean:find(":") then clean = clean:split(":")[1] end
    if clean:find("-") then clean = clean:split("-")[1] end
    clean = clean:gsub("^%s+", ""):gsub("%s+$", "")
    if clean == "" then return nil, nil end

    -- 1. Direct dictionary lookup (Sangat cepat & 100% Akurat untuk ID/EN)
    local entry = DICE_NAME_TO_TIER[clean]
    if entry then
        return entry.tier, entry.name
    end

    -- 2. Exact match with FALLBACK_25_DICES
    for idx, dName in ipairs(FALLBACK_25_DICES) do
        if clean == dName:lower() then
            return idx, dName
        end
    end

    -- 3. Standalone word match dari kamus
    for word, data in pairs(DICE_NAME_TO_TIER) do
        if clean:find("^" .. word .. "$") or clean:find("^" .. word .. "%s") or clean:find("%s" .. word .. "$") or clean:find("%s" .. word .. "%s") then
            return data.tier, data.name
        end
    end

    return nil, nil
end

