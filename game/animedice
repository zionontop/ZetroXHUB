local lastGcScanTime = 0
local cachedGcEquipped = nil
local cachedGcTier = 0

local function scanMemoryForDice()
    if not getgc then return nil, nil, nil end
    local now = os.time()
    -- Cegah scan ulang beruntun: jika baru di-scan dalam 60s dan sudah ada hasil, pakai cache
    if (now - lastGcScanTime) < 60 and cachedGcTier > 0 then
        return cachedGcEquipped, cachedGcTier, "MemoryCached"
    end
    lastGcScanTime = now

    local foundEquipped = nil
    local foundEquippedTier = 0
    local highestOwned = nil
    local highestOwnedTier = 0

    pcall(function()
        local gcList = getgc(true)
        for _, t in ipairs(gcList) do
            if typeof(t) == "table" then
                -- 1. Scan Key Dadu Aktif / Terpasang
                for k, v in pairs(t) do
                    if typeof(k) == "string" then
                        local kl = k:lower()
                        if kl == "equippeddice" or kl == "currentdice" or kl == "activedice" or kl == "dice" or kl == "equipped" then
                            if typeof(v) == "string" then
                                local tNum, dName = getTierForDice(v)
                                if tNum and tNum > foundEquippedTier then
                                    foundEquippedTier = tNum
                                    foundEquipped = dName
                                end
                            elseif typeof(v) == "number" and v >= 1 and v <= #FALLBACK_25_DICES then
                                if v > foundEquippedTier then
                                    foundEquippedTier = v
                                    foundEquipped = FALLBACK_25_DICES[v]
                                end
                            end
                        end
                    end
                end

                -- 2. Scan Daftar Dadu Milik Akun (OwnedDices / Dices / Inventory)
                local dList = rawget(t, "OwnedDices") or rawget(t, "ownedDices") or rawget(t, "Dices") or rawget(t, "dices")
                if typeof(dList) == "table" then
                    for k, v in pairs(dList) do
                        local cand = typeof(v) == "string" and v or (typeof(k) == "string" and k or nil)
                        if cand then
                            local tNum, dName = getTierForDice(cand)
                            if tNum and tNum > highestOwnedTier then
                                highestOwnedTier = tNum
                                highestOwned = dName
                            end
                        elseif typeof(v) == "number" and v >= 1 and v <= #FALLBACK_25_DICES then
                            if v > highestOwnedTier then
                                highestOwnedTier = v
                                highestOwned = FALLBACK_25_DICES[v]
                            end
                        end
                    end
                end
            end
        end
        gcList = nil
    end)

    pcall(function() collectgarbage("step", 200) end)

    if foundEquippedTier > 0 and foundEquipped then
        cachedGcEquipped = foundEquipped
        cachedGcTier = foundEquippedTier
        return foundEquipped, foundEquippedTier, "MemoryEquipped"
    end
    if highestOwnedTier > 0 and highestOwned then
        cachedGcEquipped = highestOwned
        cachedGcTier = highestOwnedTier
        return highestOwned, highestOwnedTier, "MemoryOwned"
    end
    return nil, nil, nil
end

