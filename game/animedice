local function launchTower(towerData)
    if not towerData then return false end
    currentTowerTarget = towerData
    currentTowerFloor = 0

    -- 1. Auto equip unit tower terbaik
    if Remotes.EquipBestTowerTeam then
        pcall(function() Remotes.EquipBestTowerTeam:FireServer() end)
        task.wait(0.3)
    end

    -- 2. Select Tower via Controller
    local selFn = getSelectTowerFn()
    if selFn then
        pcall(selFn, towerData.Name)
    end
    task.wait(0.8)

    -- 3. Click Fight
    local fightFn = getFightFn()
    if not fightFn then
        local waited = 0
        while waited < 3 do
            task.wait(0.3)
            waited = waited + 0.3
            fightFn = getFightFn()
            if fightFn then break end
        end
    end

    if fightFn then
        local ok = pcall(fightFn)
        if ok then return true end
    end

    -- Fallback remote
    if Remotes.PlayTower then
        local ok, res = pcall(function() return Remotes.PlayTower:InvokeServer(towerData.Name) end)
        if ok and (res == true or res == nil) then return true end
    end
    return false
end

local function isTowerEligible(towerData)
    if not towerData then return false end
    if not Config.TowersEnabled or not Config.TowersEnabled[towerData.ConfigKey] then
        return false
    end
    -- Auto-skip tier rendah HANYA JIKA diaktifkan oleh user di Config.SkipLowTierTowers (Default: FALSE agar semua tower dirotasi!)
    if Config.SkipLowTierTowers then
        local tier = tonumber(Config.CurrentDiceTier) or 1
        if towerData.ConfigKey == "DragonTower" and tier >= 10 then return false end
        if towerData.ConfigKey == "CursedTower" and tier >= 15 then return false end
        if towerData.ConfigKey == "PirateTower" and tier >= 20 then return false end
    end
    return true
end

local function getNextActiveTowerIdx(currentIdx)
    currentIdx = currentIdx or 1
    for i = 1, #TowerList do
        local checkIdx = ((currentIdx - 1 + i) % #TowerList) + 1
        local item = TowerList[checkIdx]
        if isTowerEligible(item) then
            return checkIdx
        end
    end
    if isTowerEligible(TowerList[currentIdx]) then
        return currentIdx
    end
    return nil
end

