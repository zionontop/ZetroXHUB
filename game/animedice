local function claimAllQuests()
    local pGui = player:FindFirstChild("PlayerGui")
    if not pGui then return 0 end

    local claimedCount = 0
    -- Cari tombol-tombol yang bertuliskan 'Claim' (bukan 'Claimed')
    for _, desc in ipairs(pGui:GetDescendants()) do
        if desc:IsA("TextButton") or desc:IsA("ImageButton") then
            local isClaim = false
            local btnText = (desc:IsA("TextButton") and desc.Text:lower()) or ""
            if btnText == "claim" then
                isClaim = true
            else
                for _, ch in ipairs(desc:GetChildren()) do
                    if ch:IsA("TextLabel") and ch.Text:lower() == "claim" then
                        isClaim = true
                        break
                    end
                end
            end

            if isClaim then
                -- 1. Trigger Click Event UI secara langsung
                if firesignal then
                    pcall(function() firesignal(desc.MouseButton1Click) end)
                    pcall(function() firesignal(desc.Activated) end)
                end
                if getconnections then
                    pcall(function()
                        for _, c in ipairs(getconnections(desc.Activated)) do c:Fire() end
                        for _, c in ipairs(getconnections(desc.MouseButton1Click)) do c:Fire() end
                    end)
                end

                -- 2. Tembak remote QuestService.RE.Claim jika data quest terdeteksi
                if Remotes.ClaimQuest then
                    local tabType = "Daily"
                    local questType = nil
                    local questId = nil
                    local curr = desc.Parent

                    for depth = 1, 6 do
                        if not curr then break end
                        questId = questId or curr:GetAttribute("Id") or curr:GetAttribute("Timestamp") or curr:GetAttribute("Reset") or curr:GetAttribute("Expires")
                        questType = questType or curr:GetAttribute("Type") or curr:GetAttribute("Category") or curr:GetAttribute("QuestType")
                        local cName = curr.Name
                        if tonumber(cName) then questId = questId or tonumber(cName) end
                        if cName:find("Roll") then questType = questType or "Rolls"
                        elseif cName:find("Play") or cName:find("Time") then questType = questType or "PlayTime"
                        elseif cName:find("Tower") then questType = questType or "Towers"
                        elseif cName:find("Sell") then questType = questType or "Sell"
                        end
                        if cName:lower():find("weekly") then tabType = "Weekly" end
                        if cName:lower():find("daily") then tabType = "Daily" end
                        curr = curr.Parent
                    end

                    if questType and questId then
                        pcall(function() Remotes.ClaimQuest:FireServer(tabType, questType, questId) end)
                    end
                end
                claimedCount = claimedCount + 1
                task.wait(0.15)
            end
        end
    end
    return claimedCount
end


