-- 10. Level Up Unit Slots (Lantai 1 & Lantai 2) Loop dengan Batas MaxUnitLevel
task.spawn(function()
    while task.wait(Config.UpgradeUnitDelay or 15) do
        if Config.AutoUpgradeUnits and Remotes.LevelUpSlot then
            local maxSlots = math.max(6, tonumber(Config.MaxPlotSlots) or 30)
            local maxLvl = tonumber(Config.MaxUnitLevel) or 40
            local pState = getPlayerDataState()

            for slot = 1, maxSlots do
                if not Config.AutoUpgradeUnits then break end

                -- 1. Jika slot kosong (tidak ada unit terpasang), lewati slot ini
                if pState and pState.Slots then
                    local sData = pState.Slots[slot] or pState.Slots[tostring(slot)]
                    if not sData or not sData.unitId then
                        continue
                    end
                end

                -- 2. Cek level unit di slot ini via DataController
                local curLvl = getSlotUnitLevel(slot)
                if curLvl and curLvl >= maxLvl then
                    -- Unit sudah mencapai atau melebihi batas level (e.g. >= 40), lewati!
                    continue
                end

                -- 3. Upgrade slot jika level masih di bawah batas max
                pcall(function() Remotes.LevelUpSlot:FireServer(slot) end)
                task.wait(0.08)
            end
        end
    end
end)


