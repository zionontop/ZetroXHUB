local function getEquippedUnitUUIDs(filterName)
    local allUnits = scanAllUnits()
    local target = filterName or Config.TargetUnitName or Config.TargetUnitUUID or ""

    -- Jika kosong ("") -> Targetkan SEMUA unit yang ada
    if target == "" or (typeof(target) == "table" and #target == 0) then
        local allUUIDs = {}
        for _, u in ipairs(allUnits) do
            table.insert(allUUIDs, u.UUID)
        end
        return allUUIDs
    end

    -- Jika format UUID langsung (contoh: "e678807c-8fcf-4e11-aecd-c2c34acb3268")
    if typeof(target) == "string" and target:match("^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") then
        return { target }
    end

    -- Filter berdasarkan Nama Unit (String atau Table Nama)
    local targetsToMatch = {}
    if typeof(target) == "string" then
        table.insert(targetsToMatch, target:lower():gsub("%s+", ""))
    elseif typeof(target) == "table" then
        for _, t in ipairs(target) do
            if typeof(t) == "string" and t ~= "" then
                table.insert(targetsToMatch, t:lower():gsub("%s+", ""))
            end
        end
    end

    local matched = {}
    local matchedSeen = {}
    for _, u in ipairs(allUnits) do
        local uNameClean = tostring(u.Name):lower():gsub("%s+", "")
        local uuid = u.UUID
        for _, filter in ipairs(targetsToMatch) do
            if uNameClean:find(filter, 1, true) or filter:find(uNameClean, 1, true) or uuid:lower():find(filter, 1, true) then
                if not matchedSeen[uuid] then
                    matchedSeen[uuid] = true
                    table.insert(matched, uuid)
                end
                break
            end
        end
    end

    return matched
end

