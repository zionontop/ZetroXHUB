-- 8. AUTO TOWER PROGRESSION LOOP (ARCADEHUB PROVEN LOGIC)
task.spawn(function()
    task.wait(2)
    while true do
        if Config.AutoTowerRoll then
            local activeIdx = tonumber(Config.CurrentTowerIdx) or 1
            if activeIdx < 1 or activeIdx > #TowerList then activeIdx = 1; Config.CurrentTowerIdx = 1 end
            local towerData = TowerList[activeIdx]

            -- Cek kelayakan tower (apakah diaktifkan di Config.TowersEnabled)
            if not isTowerEligible(towerData) then
                local nextIdx = getNextActiveTowerIdx(activeIdx)
                if not nextIdx then
                    currentTowerTarget = nil
                    currentTowerFloor = 0
                    currentKaitunStatus = "🛑 Semua Tower Selesai/Off"
                    task.wait(3)
                    continue
                end
                Config.CurrentTowerIdx = nextIdx
                task.wait(1)
                continue
            end

            currentTowerTarget = towerData
            currentTowerFloor = 0
            currentKaitunStatus = string.format("🏰 Masuk %s (%s)", towerData.Name, towerData.Diff)
            -- print(string.format("[ZionHub] 🏰 Memulai %s (%s)...", towerData.Name, towerData.Diff))

            local started = launchTower(towerData)
            if not started then
                -- print(string.format("[ZionHub] ⚠️ Gagal masuk %s, coba lagi dalam 3 detik...", towerData.Name))
                task.wait(3)
                continue
            end

            -- Battle loop: monitor floor and completion
            local lastFloor = 0
            local noProgress = 0
            local TIMEOUT = 90
            local maxFloor = (towerData.Name == "Infinity Tower" and 200) or 100

            while Config.AutoTowerRoll do
                task.wait(1)

                -- Cek kondisi character mati
                local char = player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then
                    -- print(string.format("[ZionHub] 💀 Karakter mati di tower %s.", towerData.Name))
                    break
                end

                -- Baca TextLabel Floor in-game
                pcall(function()
                    local r = player.PlayerGui:FindFirstChild("Root")
                    local fl = r and r:FindFirstChild("Tower") and r.Tower:FindFirstChild("Screen") and r.Tower.Screen:FindFirstChild("Floor")
                    if fl and fl.Text then
                        local n = tonumber(fl.Text:match("%d+"))
                        if n and n > 0 then
                            currentTowerFloor = n
                        end
                    end
                end)

                if currentTowerFloor > 0 then
                    currentKaitunStatus = string.format("⚔️ %s [Floor %d]", towerData.Name, currentTowerFloor)
                end

                if currentTowerFloor ~= lastFloor then
                    lastFloor = currentTowerFloor
                    noProgress = 0
                else
                    noProgress = noProgress + 1
                end

                -- Cek apakah sudah mencapai max floor
                if currentTowerFloor >= maxFloor then
                    -- print(string.format("[ZionHub] 🏁 %s selesai! Mencapai Floor %d", towerData.Name, maxFloor))
                    break
                end

                -- Cek apakah TowerRewards muncul (tanda battle berakhir)
                local isRewardsOpen = false
                pcall(function()
                    local r = player.PlayerGui:FindFirstChild("Root")
                    local rew = r and r:FindFirstChild("Menus") and r.Menus:FindFirstChild("TowerRewards")
                    if rew and rew.Visible then
                        isRewardsOpen = true
                    end
                end)

                if isRewardsOpen then
                    -- print(string.format("[ZionHub] 🎁 Reward menu muncul! %s selesai.", towerData.Name))
                    break
                end

                -- Watchdog: jika macet tanpa kenaikan floor selama TIMEOUT detik
                if noProgress >= TIMEOUT then
                    -- print(string.format("[ZionHub] ⚠️ Watchdog timeout di tower %s, membatalkan...", towerData.Name))
                    if Remotes.CancelTower then
                        pcall(function() Remotes.CancelTower:InvokeServer() end)
                    end
                    break
                end

                -- Roll dice di dalam tower
                if Config.AutoRoll and Remotes.RollDice then
                    pcall(function() Remotes.RollDice:InvokeServer() end)
                end
            end

            -- Tunggu reward ditutup (maksimal 15 detik)
            currentKaitunStatus = string.format("🎁 %s Selesai, Menunggu...", towerData.Name)
            local rewWait = 0
            while rewWait < 15 do
                local isOpen = false
                pcall(function()
                    local r = player.PlayerGui:FindFirstChild("Root")
                    local rew = r and r:FindFirstChild("Menus") and r.Menus:FindFirstChild("TowerRewards")
                    if rew and rew.Visible then isOpen = true end
                end)
                if not isOpen then break end
                rewWait = rewWait + 1
                task.wait(1)
            end

            task.wait(2)

            -- Rotasi ke tower berikutnya
            local nextIdx = getNextActiveTowerIdx(activeIdx)
            if nextIdx then
                Config.CurrentTowerIdx = nextIdx
                local nextData = TowerList[Config.CurrentTowerIdx]
                if nextData then
                    -- print(string.format("[ZionHub] ⏳ Rotasi ke tower berikutnya: %s (%s)", nextData.Name, nextData.Diff))
                end
            else
                Config.CurrentTowerIdx = 1
            end
            currentTowerTarget = nil
            currentTowerFloor = 0
            task.wait(2)
        else
            currentTowerTarget = nil
            currentTowerFloor = 0
            task.wait(2)
        end
    end
end)

