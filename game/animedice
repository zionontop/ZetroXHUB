local function syncBoostConfigFromGame()
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local fw = RS:FindFirstChild("Framework")
        local feats = fw and fw:FindFirstChild("Features")
        local inv = feats and feats:FindFirstChild("Inventory")
        local kinds = inv and inv:FindFirstChild("Kinds")
        local boostKind = kinds and kinds:FindFirstChild("Boost")
        local bConfigMod = boostKind and boostKind:FindFirstChild("BoostConfig")
        if not bConfigMod then return end

        local ok, mod = pcall(require, bConfigMod)
        if not ok or not mod or not mod.entries or typeof(mod.entries) ~= "table" then return end

        local seenCats = { ["Luck"] = true, ["Damage"] = true, ["Income"] = true }
        local seenTiers = {}
        local tierList = {}

        for entryName, entryData in pairs(mod.entries) do
            if typeof(entryData) == "table" then
                local rawCat = entryData.category or entryName
                local core = getCoreBoostType(rawCat)
                local tNum = tonumber(entryData.tier)
                if not tNum then
                    local rom = entryName:match("%s+(VI|VII|VIII|IV|V|III|II|I)$")
                    if rom then tNum = ROMAN_TO_INT_MAP[rom] end
                end
                tNum = tNum or 1

                ALL_GAME_POTIONS[entryName] = { core = core, tier = tNum }

                if core and not seenCats[core] then
                    seenCats[core] = true
                    table.insert(AVAILABLE_BOOST_CATEGORIES, core)
                end

                local r = ROMAN_NUMERALS_MAP[tNum] or tostring(tNum)
                local tName = "Tier " .. r
                if not seenTiers[tName] then
                    seenTiers[tName] = true
                    table.insert(tierList, { name = tName, num = tNum })
                end
            end
        end

        if #tierList > 0 then
            table.sort(tierList, function(a, b) return a.num < b.num end)
            local sortedTiers = {}
            for _, t in ipairs(tierList) do
                table.insert(sortedTiers, t.name)
            end
            AVAILABLE_BOOST_TIERS = sortedTiers
        end
    end)
end
pcall(syncBoostConfigFromGame)

-- Helper: Menyelesaikan data Potion (Core Type & Tier angka) baik dari registry maupun deteksi dinamis
local function resolvePotionData(potName)
    if not potName or type(potName) ~= "string" then return nil end
    if ALL_GAME_POTIONS[potName] then return ALL_GAME_POTIONS[potName] end

    local core = getCoreBoostType(potName)
    local rom = potName:match("%s+(VI|VII|VIII|IV|V|III|II|I)$")
    local tNum = rom and ROMAN_TO_INT_MAP[rom] or 1
    local pData = { core = core, tier = tNum }
    ALL_GAME_POTIONS[potName] = pData
    return pData
end

-- Scanner Inventory Akurat (DataController + Controllers + PlayerGui Fallback)
-- Mengembalikan tabel: [namaPotion] = jumlah (number > 0)
local function scanOwnedPotions()
    local owned = {}

    local function recordPotion(name, amt)
        if not name then return end
        local potName = tostring(name)
        local pData = resolvePotionData(potName)
        if pData then
            local count = tonumber(amt) or 1
            if count > 0 then
                owned[potName] = (owned[potName] or 0) + count
            end
        end
    end

    local function checkItem(k, v)
        if not v then return end

        local kStr = tostring(k)
        if ALL_GAME_POTIONS[kStr] then
            local amt = 0
            if type(v) == "number" then
                amt = v
            elseif type(v) == "table" then
                amt = tonumber(v.amount or v.count or v.quantity or v.Amount or (v.attributes and (v.attributes.amount or v.attributes.count or v.attributes.quantity)) or 1) or 0
            end
            if amt > 0 then
                recordPotion(kStr, amt)
                return
            end
        end

        if type(v) == "table" then
            local rawName = v.name or v.entryName or v.ItemName or v.id or (v.attributes and (v.attributes.name or v.attributes.entryName))
            if rawName and type(rawName) == "string" and (ALL_GAME_POTIONS[rawName] or rawName:lower():find("luck") or rawName:lower():find("damage") or rawName:lower():find("income")) then
                local amt = tonumber(v.amount or v.count or v.quantity or v.Amount or (v.attributes and (v.attributes.amount or v.attributes.count or v.attributes.quantity)) or 1) or 1
                if amt > 0 then
                    recordPotion(rawName, amt)
                end
            end
        end
    end

    local function scanTable(t, depth)
        if not t or typeof(t) ~= "table" then return end
        depth = depth or 0
        if depth > 3 then return end

        for k, v in pairs(t) do
            checkItem(k, v)
            if typeof(v) == "table" and (type(k) == "string" and (k:lower():find("boost") or k:lower():find("item") or k:lower():find("potion") or k:lower():find("inventory") or k == "Data" or k == "Replica")) then
                scanTable(v, depth + 1)
            end
        end
    end

    -- 1. Scan pState (DataController)
    local pState = getPlayerDataState()
    if pState and typeof(pState) == "table" then
        scanTable(pState.Inventory, 0)
        scanTable(pState.Boosts, 0)
        scanTable(pState.Boost, 0)
        scanTable(pState.Items, 0)
        scanTable(pState.Bag, 0)
        if pState.Data and typeof(pState.Data) == "table" then
            scanTable(pState.Data.Inventory, 0)
            scanTable(pState.Data.Boosts, 0)
            scanTable(pState.Data.Items, 0)
        end
        for k, v in pairs(pState) do
            if type(k) == "string" and ALL_GAME_POTIONS[k] then
                checkItem(k, v)
            end
        end
    end

    -- 2. Scan InventoryController jika ada
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local fw = RS:FindFirstChild("Framework")
        local feats = fw and fw:FindFirstChild("Features")
        local invMod = feats and feats:FindFirstChild("Inventory") and (feats.Inventory:FindFirstChild("InventoryController") or feats.Inventory:FindFirstChild("Controller"))
        if invMod then
            local ok, invCtrl = pcall(require, invMod)
            if ok and invCtrl and typeof(invCtrl) == "table" then
                if type(invCtrl.GetInventory) == "function" then
                    local ok2, res = pcall(invCtrl.GetInventory, invCtrl)
                    if ok2 and res then scanTable(res, 0) end
                end
                if type(invCtrl.GetItems) == "function" then
                    local ok2, res = pcall(invCtrl.GetItems, invCtrl)
                    if ok2 and res then scanTable(res, 0) end
                end
            end
        end
    end)

    -- 3. Fallback scan PlayerGui HANYA jika owned masih kosong
    local foundAny = false
    for _ in pairs(owned) do foundAny = true; break end
    if not foundAny then
        pcall(function()
            local pGui = player:FindFirstChild("PlayerGui")
            if pGui then
                for _, desc in ipairs(pGui:GetDescendants()) do
                    if desc:IsA("TextLabel") or desc:IsA("GuiObject") then
                        local text = desc:IsA("TextLabel") and desc.Text or desc.Name
                        if text and text ~= "" and ALL_GAME_POTIONS[text] then
                            local amt = 1
                            local parent = desc.Parent
                            if parent then
                                for _, sibling in ipairs(parent:GetChildren()) do
                                    if sibling:IsA("TextLabel") and sibling ~= desc then
                                        local num = sibling.Text:match("[xX]%s*(%d+)") or sibling.Text:match("^(%d+)$")
                                        if num then amt = tonumber(num) or 1; break end
                                    end
                                end
                            end
                            recordPotion(text, amt)
                        end
                    end
                end
            end
        end)
    end

    return owned
end

