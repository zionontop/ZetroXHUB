-- Scanner Kartu Dadu Nyata di Layar / PlayerGui (Strict Dadu Filter, Immutable FALLBACK_25_DICES)
local function scanRealDiceShopCards()
    local pGui = player:FindFirstChild("PlayerGui")
    if not pGui then return {} end

    local cards = {}
    local seen = {}

    for _, lbl in ipairs(pGui:GetDescendants()) do
        if lbl.Name:find("Zion") or (lbl.Parent and lbl.Parent.Name:find("Zion")) then continue end
        if lbl:IsA("TextLabel") and typeof(lbl.Text) == "string" and lbl.Text:find("|") then
            local text = lbl.Text
            local textLower = text:lower()
            if not textLower:find("luck") and not textLower:find("keberuntungan") and not textLower:find("pass") and not textLower:find("putaran") then
                local parts = text:split("|")
                if #parts == 2 then
                    local dName = parts[1]:gsub("^%s+", ""):gsub("%s+$", "")
                    local dRarity = parts[2]:gsub("^%s+", ""):gsub("%s+$", "")

                    -- Filter ketat: HANYA dadu resmi yang ada di daftar 1-25!
                    local dTier, canonName = getTierForDice(dName)
                    if not dTier then
                        dTier, canonName = getTierForDice(lbl.Text)
                    end
                    if not dTier then continue end

                    local cardRoot = lbl.Parent
                    for depth = 1, 4 do
                        if cardRoot and (cardRoot:FindFirstChildWhichIsA("TextButton", true) or cardRoot:FindFirstChildWhichIsA("ImageButton", true)) then
                            break
                        end
                        if cardRoot and cardRoot.Parent and cardRoot.Parent:IsA("GuiObject") and not cardRoot.Parent:IsA("ScrollingFrame") and not cardRoot.Parent:IsA("ScreenGui") then
                            cardRoot = cardRoot.Parent
                        else
                            break
                        end
                    end

                    if cardRoot and not seen[cardRoot] then
                        seen[cardRoot] = true

                        local btn = cardRoot:FindFirstChildWhichIsA("TextButton", true) or cardRoot:FindFirstChildWhichIsA("ImageButton", true)
                        local btnText = ""
                        if btn and btn:IsA("TextButton") then
                            btnText = tostring(btn.Text)
                        elseif btn then
                            local t = btn:FindFirstChildWhichIsA("TextLabel", true)
                            if t then btnText = tostring(t.Text) end
                        end

                        local isEquipped = isButtonTextEquipped(btnText)
                        local isOwned = isButtonTextOwned(btnText)

                        -- Periksa juga label status lain di dalam kartu
                        if not isEquipped then
                            for _, subLbl in ipairs(cardRoot:GetDescendants()) do
                                if subLbl:IsA("TextLabel") and subLbl ~= lbl then
                                    if isButtonTextEquipped(subLbl.Text) then
                                        isEquipped = true
                                        isOwned = true
                                        break
                                    elseif not isOwned and isButtonTextOwned(subLbl.Text) then
                                        isOwned = true
                                    end
                                end
                            end
                        end

                        table.insert(cards, {
                            Name = canonName or dName,
                            Tier = dTier,
                            Rarity = dRarity,
                            Button = btn,
                            ButtonText = btnText,
                            Card = cardRoot,
                            IsOwned = isOwned,
                            IsEquipped = isEquipped,
                            YPos = cardRoot.AbsolutePosition.Y,
                            LayoutOrder = cardRoot.LayoutOrder
                        })
                    end
                end
            end
        end
    end

    -- Urutkan kartu secara presisi berdasarkan Tier resmi (1 -> 25)
    table.sort(cards, function(a, b)
        return a.Tier < b.Tier
    end)

    return cards
end

