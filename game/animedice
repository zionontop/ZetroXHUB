        if uiRefs.thresholdLabel then
            uiRefs.thresholdLabel.Text = string.format("Threshold: Disabled (Tier 1: %s | Menunggu Tier 2)", diceName or "Normal")
        end
        if uiRefs.thresholdInput then
            uiRefs.thresholdInput.Text = "0 (Tier 1 No Sell)"
        end
        return
    end

    if Remotes.UpdateAutoSell then
        pcall(function() Remotes.UpdateAutoSell:FireServer(matchedThreshold) end)
    end

    if uiRefs.thresholdLabel then
        uiRefs.thresholdLabel.Text = string.format("Threshold: %s (Tier %d: %s | Step: %dT)",
            tostring(matchedThreshold), diceTier or 1, diceName or "Unknown", Config.SellThresholdTierStep or 4)
    end
    if uiRefs.thresholdInput then
        uiRefs.thresholdInput.Text = tostring(matchedThreshold)
    end
end

